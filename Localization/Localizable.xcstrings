    "Looking for your face in the camera video. This happens once; the result is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gesicht wird im Kameravideo gesucht. Das geschieht einmal; das Ergebnis wird gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de votre visage dans la vidéo de la caméra. Cela n’a lieu qu’une fois ; le résultat est conservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラ映像から顔を探しています。一度だけ行い、結果は保存されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск лица в видео с камеры. Это делается один раз; результат сохраняется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук обличчя у відео з камери. Це робиться один раз; результат зберігається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在摄像头视频中寻找面部。只需进行一次，结果会被保留。"
          }
        }
      }
    },
    "Looking through the video…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video wird durchsucht …"
          }
        },
