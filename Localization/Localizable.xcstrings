    "Text recognition, captions, Whisper, Find private info, face tracking, background removal, and voice cleanup all run on your Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texterkennung, Untertitel, Whisper, Private Infos finden, Gesichtsverfolgung, Hintergrundentfernung und Stimmverbesserung laufen alle auf deinem Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance de texte, les sous-titres, Whisper, Infos privées, le suivi du visage, la suppression de l’arrière-plan et le nettoyage de la voix fonctionnent tous sur votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
