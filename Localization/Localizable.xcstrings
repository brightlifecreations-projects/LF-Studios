    "LF Studios can't save to that folder. Pick another place, like Desktop or Movies, and export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios kann nicht in diesem Ordner sichern. Wähle einen anderen Ort, etwa „Schreibtisch“ oder „Filme“, und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ne peut pas enregistrer dans ce dossier. Choisissez un autre emplacement, comme Bureau ou Vidéos, puis exportez à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosはそのフォルダに保存できません。“デスクトップ”や“ムービー”など別の場所を選択して、もう一度書き出してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не может сохранить файл в эту папку. Выберите другое место, например «Рабочий стол» или «Фильмы», и экспортируйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не може зберігати в цю папку. Виберіть інше місце, наприклад «Робочий стіл» чи «Фільми», і експортуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 无法存储到该文件夹。请选择其他位置（如“桌面”或“影片”），然后重新导出。"
          }
        }
      }
    },
    "LF Studios can't write to the save folder. Choose another one in Settings → Screenshots." : {
      "comment" : "Names LF Studios' Settings pane where the save folder is chosen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios kann nicht in den Zielordner schreiben. Wähle einen anderen unter „Einstellungen“ → „Bildschirmfotos“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ne peut pas écrire dans le dossier d’enregistrement. Choisissez-en un autre dans Réglages → Captures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは保存先フォルダに書き込めません。“設定”＞“スクリーンショット”で別のフォルダを選択してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не может записывать в папку для сохранения. Выберите другую в разделе Настройки → Снимки экрана."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не може записувати в папку збереження. Виберіть іншу в розділі Параметри → Знімки екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 无法写入存储文件夹。请在“设置”→“截屏”中选择其他文件夹。"
          }
        }
      }
