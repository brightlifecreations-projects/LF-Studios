    "“%@” is your My Style — Apply my style (⇧⌘Y) puts it on a video" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist dein „Mein Stil“ – „Meinen Stil anwenden“ (⇧⌘Y) bringt ihn auf ein Video"
          }
        },
        "fr" : {
