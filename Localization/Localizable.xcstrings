    "Projects from ShotStyle (.shotstyle) open too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekte aus ShotStyle (.shotstyle) öffnen sich auch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets de ShotStyle (.shotstyle) s’ouvrent aussi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShotStyleのプロジェクト（.shotstyle）も開けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проекты из ShotStyle (.shotstyle) тоже открываются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проєкти ShotStyle (.shotstyle) теж відкриваються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShotStyle 的项目（.shotstyle）也可以打开。"
          }
        }
      }
    },
    "Projects shows your recordings, screenshots, and saved projects, newest first. Click one to open it. Right-click for Show in Finder, Creative Handoff…, or Delete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Projekte“ zeigt deine Aufnahmen, Bildschirmfotos und gesicherten Projekte, die neuesten zuerst. Klicke auf eines, um es zu öffnen. Mit einem Rechtsklick findest du „Im Finder zeigen“, „Kreative Übergabe …“ und „Löschen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projets affiche vos enregistrements, captures et projets enregistrés, du plus récent au plus ancien. Cliquez sur l’un d’eux pour l’ouvrir. Clic droit pour Afficher dans le Finder, Transmission créative… ou Supprimer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“プロジェクト”には、収録したビデオ、スクリーンショット、保存したプロジェクトが新しい順に表示されます。クリックすると開きます。右クリックすると、“Finderに表示”、“クリエイティブ受け渡し…”、“削除”を選べます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В разделе «Проекты» — ваши записи, снимки и сохраненные проекты, сначала новые. Нажмите на любой, чтобы открыть его. Правой кнопкой мыши — «Показать в Finder», «Творческая передача…» или «Удалить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «Проєктах» — ваші записи, знімки та збережені проєкти, найновіші вгорі. Клацніть, щоб відкрити. Клацніть правою кнопкою, щоб вибрати «Показати у Finder», «Творче передавання…» або «Видалити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“项目”按从新到旧显示你的录制内容、截屏和已存储的项目。点按一项即可打开。右键点按可选择“在‘访达’中显示”“创意交付…”或“删除”。"
          }
        }
      }
    },
