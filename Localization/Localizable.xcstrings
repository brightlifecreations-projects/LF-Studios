    "Models are downloaded only when you click Download, and can be deleted to free up space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle werden nur geladen, wenn du auf „Laden“ klickst, und lassen sich löschen, um Platz freizugeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles ne sont téléchargés que si vous cliquez sur Télécharger, et peuvent être supprimés pour libérer de l’espace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルは“ダウンロード”をクリックしたときだけダウンロードされ、空き領域を増やすために削除することもできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели загружаются, только когда вы нажмете «Загрузить», и их можно удалить, чтобы освободить место."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моделі завантажуються, лише коли ви клацнете «Завантажити», і їх можна видалити, щоб звільнити місце."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你点按“下载”时才会下载模型，你也可以删除模型来释放空间。"
