    "Right-click a clip for Speed, Mute Clip, Move Earlier, and Move Later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Rechtsklick auf einen Clip findest du „Tempo“, „Clip stummschalten“, „Nach vorn verschieben“ und „Nach hinten verschieben“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic droit sur un clip pour Vitesse, Couper le son du clip, Déplacer plus tôt et Déplacer plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップを右クリックすると、“速度”、“クリップを消音”、“前に移動”、“後ろに移動”を選べます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правой кнопкой мыши на клипе — «Скорость», «Выключить звук клипа», «Сдвинуть раньше» и «Сдвинуть позже»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть кліп правою кнопкою, щоб вибрати «Швидкість», «Вимкнути звук кліпу», «Перемістити раніше» й «Перемістити пізніше»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按片段可选择“速度”“将片段静音”“向前移动”和“向后移动”。"
          }
        }
      }
    },
    "Right-click a project in Home ▸ Delete: it goes to the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklick auf ein Projekt im Startfenster ▸ Löschen: Es kommt in den Papierkorb."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic droit sur un projet dans l’accueil ▸ Supprimer : il va dans la corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
