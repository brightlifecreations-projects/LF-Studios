    "Add another recording or video after this one — LF Studios recordings keep their pointer, clicks, and shortcuts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge nach dieser Aufnahme eine weitere Aufnahme oder ein Video hinzu – LF-Studios-Aufnahmen behalten ihren Zeiger, ihre Klicks und Kurzbefehle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un autre enregistrement ou une autre vidéo après celui-ci — les enregistrements LF Studios conservent leur pointeur, leurs clics et leurs raccourcis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオの後ろに別の収録やビデオを追加できます。LF Studiosで収録したビデオは、ポインタ、クリック、ショートカットを保持します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте после этой записи другую запись или видео — записи LF Studios сохраняют свой указатель, нажатия и сочетания клавиш."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте після цього ще один запис чи відео — записи LF Studios зберігають свій курсор, клацання й скорочення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此录制内容之后添加另一个录制内容或视频 — LF Studios 录制内容会保留指针、点按和快捷键。"
          }
        }
      }
    },
