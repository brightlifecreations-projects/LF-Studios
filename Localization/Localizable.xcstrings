    "Less rumble and boom, more presence" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Rumpeln und Dröhnen, mehr Präsenz"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de grondement et de résonance, plus de présence"
