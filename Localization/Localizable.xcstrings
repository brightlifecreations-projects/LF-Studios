        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У меню «Показ» виберіть, які субтитри показує відео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“显示”选择视频中显示哪套字幕。"
          }
        }
      }
    },
    "Use Show to switch between the original and the translation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle mit „Anzeigen“ zwischen Original und Übersetzung."
          }
