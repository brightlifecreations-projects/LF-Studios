    "Choose a .ttf or .otf font. LF Studios keeps its own copy, so it keeps working if the file is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine .ttf- oder .otf-Schrift. LF Studios behält eine eigene Kopie, damit sie auch funktioniert, wenn die Datei gelöscht wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une police .ttf ou .otf. LF Studios en garde sa propre copie, qui continue de fonctionner si le fichier est supprimé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".ttfまたは.otfのフォントを選択してください。LF Studiosは独自のコピーを保持するため、ファイルが削除されても使い続けられます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите шрифт .ttf или .otf. LF Studios сохранит свою копию, и шрифт продолжит работать, даже если файл удалить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть шрифт .ttf або .otf. LF Studios збереже власну копію, тож шрифт працюватиме, навіть якщо файл видалити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 .ttf 或 .otf 字体。LF Studios 会保留自己的副本，因此即使文件被删除也能继续使用。"
          }
        }
      }
    },
