    "Deleted screenshots stay in LF Studios' trash for 7 days, and ⌘Z brings them back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Bildschirmfotos bleiben 7 Tage im Papierkorb von LF Studios, und ⌘Z holt sie zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
