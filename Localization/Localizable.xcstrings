    "Record with “Track where I type” on (Settings → Recording) to zoom in on typing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm mit „Verfolgen, wo ich tippe“ auf (Einstellungen → Aufzeichnung), um aufs Tippen zu zoomen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez avec « Suivre où je tape » activé (Réglages → Enregistrement) pour zoomer sur la saisie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力箇所をズームするには、“入力場所を追跡”をオンにして収録してください（設定 → 収録）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте с включённым «Следить, где я печатаю» (Настройки → Запись), чтобы увеличивать набор текста."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записуйте з увімкненим «Стежити, де я друкую» (Параметри → Запис), щоб наближати набір тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“跟踪打字位置”（设置 → 录制）后录制，即可缩放到打字处。"
          }
        }
      }
    },
    "Record with “Track where I type” on to zoom in on typing" : {
