            "state" : "translated",
            "value" : "Не вдалося записати GIF. Перевірте, чи є вільне місце, або експортуйте коротшу частину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入 GIF。请确认有足够的可用空间，或导出较短的部分。"
