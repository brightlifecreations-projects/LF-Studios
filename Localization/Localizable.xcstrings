            "value" : "Виберіть кліп або виділіть частину, перетягнувши з ⇧, і задайте «Швидкість» на панелі праворуч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个片段，或按住 ⇧ 拖移选出一段，然后在右侧面板中选择它的“速度”。"
          }
        }
      }
    },
    "Select a range to cut" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereich zum Schneiden auswählen"
