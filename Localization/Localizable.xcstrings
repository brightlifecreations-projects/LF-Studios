          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把抖动的鼠标移动变成平稳、顺滑的滑动。"
          }
        }
      }
    },
    "Turn the video's sound back on" : {
      "localizations" : {
