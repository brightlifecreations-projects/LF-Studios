    "Turn on Auto-zoom on clicks — keeps zooms you placed by hand" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Zoom bei Klicks einschalten – von Hand gesetzte Zooms bleiben"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le zoom auto sur les clics — les zooms placés à la main sont conservés"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックで自動ズームをオンにする — 手動で置いたズームはそのまま"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
