    },
    "Turning it off removes its zooms again; zooms you added yourself stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausschalten entfernt seine Zooms wieder; Zooms, die du selbst hinzugefügt hast, bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le désactiver retire ses zooms ; ceux que vous avez ajoutés vous-même restent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、自動で追加されたズームは削除されます。自分で追加したズームは残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключить этот параметр, его увеличения снова исчезнут; добавленные вами вручную останутся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вимкнути функцію, її наближення знову зникнуть; наближення, які ви додали самі, залишаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭它会再次移除它添加的缩放；你自己添加的缩放会保留。"
