    "Put a logo, a watermark, or a picture on the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg ein Logo, ein Wasserzeichen oder ein Bild über das Video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez un logo, un filigrane ou une image sur la vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロゴ、透かし、画像をビデオに入れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разместите на видео логотип, водяной знак или картинку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте на відео логотип, водяний знак чи зображення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在视频上放置标志、水印或图片。"
          }
        }
      }
    },
    "Put your recording on a wallpaper, a gradient, a color, or your own picture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg deine Aufnahme auf ein Hintergrundbild, einen Farbverlauf, eine Farbe oder dein eigenes Bild."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez votre enregistrement sur un fond d’écran, un dégradé, une couleur ou votre propre image."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録を、壁紙、グラデーション、単色、または自分の画像の上に置きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите запись на обои, градиент, цвет или свою картинку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмістіть запис на шпалерах, градієнті, кольорі чи власному зображенні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把录制内容放在墙纸、渐变、纯色或你自己的图片上。"
          }
        }
      }
    },
    "Put your screenshot on a gradient, a color, or a picture, with rounded corners and a shadow: ready to share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg dein Bildschirmfoto auf einen Farbverlauf, eine Farbe oder ein Bild, mit abgerundeten Ecken und Schatten – fertig zum Teilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez votre capture sur un dégradé, une couleur ou une image, avec des coins arrondis et une ombre : prête à partager."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットを、角の丸みとシャドウを付けて、グラデーション、単色、または画像の上に置きます。そのまま共有できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите снимок на градиент, цвет или картинку, со скругленными углами и тенью, — и можно делиться."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмістіть знімок на градієнті, кольорі чи зображенні, із заокругленими кутами й тінню, — і можна ділитися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把截屏放在渐变、纯色或图片上，加上圆角和阴影，就可以直接分享了。"
          }
        }
      }
    },
    "Put “%@” on this video (⇧⌘Y)" : {
