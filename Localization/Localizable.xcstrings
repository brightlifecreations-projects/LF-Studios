    "Change the order with Move earlier and Move later, or remove one with Remove from this video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere die Reihenfolge mit „Nach vorn“ und „Nach hinten“ oder entferne eine mit „Aus diesem Video entfernen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez l’ordre avec Plus tôt et Plus tard, ou retirez-en un avec Retirer de cette vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "順番は“前に移動”と“後ろに移動”で変更し、取り除くには“このビデオから削除”を使います。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняйте порядок кнопками «Раньше» и «Позже» или уберите запись кнопкой «Удалить из этого видео»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінюйте порядок кнопками «Раніше» й «Пізніше» або вилучіть запис кнопкою «Вилучити з цього відео»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用“前移”和“后移”更改顺序，或用“从此视频中移除”去掉其中一段。"
          }
        }
      }
    },
