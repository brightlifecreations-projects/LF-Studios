        }
      }
    },
    "Select which display to record fullscreen" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Bildschirm für die Vollbildaufzeichnung"
          }
        },
