          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的项目、录制内容、设置和权限都会保持原样。"
          }
        }
      }
    },
    "Your recordings and screenshots will appear here" : {
      "comment" : "Home window: no projects yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
