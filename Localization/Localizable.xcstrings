    "Home ▸ New recording, or the LF Studios menu in the menu bar ▸ Record Area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start ▸ Neue Aufnahme, oder das LF-Studios-Menü in der Menüleiste ▸ Bereich aufzeichnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accueil ▸ Nouvel enregistrement, ou le menu LF Studios dans la barre des menus ▸ Enregistrer une zone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ホーム”＞“新規収録”、またはメニューバーのLF Studiosメニュー＞“範囲を収録”。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главная ▸ Новая запись или меню LF Studios в строке меню ▸ Записать область."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головна ▸ Новий запис або меню LF Studios у смузі меню ▸ Записати область."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主页 ▸ 新录制，或菜单栏中的 LF Studios 菜单 ▸ 录制区域。"
          }
        }
      }
    },
    "Home ▸ Projects. Recordings and Screenshots in the sidebar show just one kind." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start ▸ Projekte. „Aufnahmen“ und „Bildschirmfotos“ in der Seitenleiste zeigen nur jeweils eine Art."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accueil ▸ Projets. Enregistrements et Captures, dans la barre latérale, n’en affichent qu’un seul type."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ホーム”＞“プロジェクト”。サイドバーの“収録したビデオ”と“スクリーンショット”では、それぞれの種類だけを表示します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главная ▸ Проекты. «Записи» и «Снимки экрана» в боковом меню показывают только что-то одно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головна ▸ Проєкти. «Записи» й «Знімки екрана» на бічній панелі показують лише один тип."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主页 ▸ 项目。边栏中的“录制内容”和“截屏”只显示一种类型。"
          }
        }
      }
    },
    "Home ▸ Scroll capture, or the LF Studios menu in the menu bar ▸ Scrolling Capture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start ▸ Scroll-Aufnahme, oder das LF-Studios-Menü in der Menüleiste ▸ Scroll-Aufnahme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
