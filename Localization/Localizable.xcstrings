    },
    "Play a song under your video. It loops, fades in and out, and gets quieter while you talk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiel einen Song unter deinem Video ab. Er läuft in Schleife, wird ein- und ausgeblendet und leiser, während du sprichst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites jouer un morceau sous votre vidéo. Il tourne en boucle, apparaît et disparaît en fondu, et baisse quand vous parlez."
