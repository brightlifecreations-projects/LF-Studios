        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你自己的外观，一键即可应用。"
          }
        }
      }
    },
    "Your presets, fonts, capture history, and recording edits came along too. ShotStyle's own copy is untouched, so you can delete the old app whenever you're ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Vorlagen, Schriften, der Aufnahmeverlauf und die Bearbeitungen deiner Aufnahmen sind auch dabei. Die Daten von ShotStyle bleiben unverändert, du kannst die alte App also löschen, wann immer du möchtest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos préréglages, polices, historique de captures et modifications d’enregistrements ont suivi aussi. La copie de ShotStyle reste intacte : vous pouvez supprimer l’ancienne app quand vous voulez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセット、フォント、キャプチャ履歴、収録の編集内容もすべて引き継がれています。ShotStyle側のデータはそのまま残っているので、古いアプリはいつでも削除できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пресеты, шрифты, история снимков и правки записей тоже перенесены. Копия ShotStyle не изменилась, так что старое приложение можно удалить, когда захотите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пресети, шрифти, історію знімків і правки записів теж перенесено. Копія ShotStyle не змінилася, тож старий застосунок можна видалити будь-коли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的预设、字体、截屏历史和录制内容的编辑也一并带了过来。ShotStyle 自己的副本保持不变，你可以随时删除旧应用。"
          }
        }
      }
    },
    "Your projects, recordings, settings, and permissions stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Projekte, Aufnahmen, Einstellungen und Berechtigungen bleiben, wie sie sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos projets, enregistrements, réglages et autorisations restent tels quels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクト、収録、設定、アクセス許可はそのまま残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши проекты, записи, настройки и разрешения остаются как были."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
