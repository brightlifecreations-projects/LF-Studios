          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет шрифта: установите шрифт на этот Mac или добавьте его через «Добавить файл шрифта…» в меню шрифтов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бракує шрифту: установіть шрифт на цьому Mac або додайте його через «Додати файл шрифту…» в меню шрифтів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字体不见了：在这台 Mac 上安装该字体，或在字体菜单中用“添加字体文件…”添加它。"
          }
        }
      }
    },
    "Font, Size (S, M, L), and Position (Bottom or Top)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrift, Größe (S, M, L) und Position (Unten oder Oben)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Police, Taille (S, M, L) et Position (En bas ou En haut)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“フォント”、“サイズ”（“小”、“中”、“大”）、“位置”（“下”または“上”）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
