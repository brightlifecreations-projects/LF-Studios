    "Speech recognition is turned off for LF Studios in System Settings → Privacy & Security → Speech Recognition. Turn it on, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung ist für LF Studios unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Spracherkennung“ deaktiviert. Aktiviere sie und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale est désactivée pour LF Studios dans Réglages Système → Confidentialité et sécurité → Reconnaissance vocale. Activez-la, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosの音声認識が“システム設定”＞“プライバシーとセキュリティ”＞“音声認識”でオフになっています。オンにしてから、もう一度お試しください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи выключено для LF Studios в разделе Системные настройки → Конфиденциальность и безопасность → Распознавание речи. Включите его и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розпізнавання мовлення для LF Studios вимкнено (Системні параметри → Приватність і безпека → Розпізнавання мовлення). Увімкніть його й спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 的语音识别已在“系统设置”→“隐私与安全性”→“语音识别”中关闭。请将其打开，然后重试。"
          }
        }
      }
    },
