    "Free up space taken by data for recordings that are gone, unused camera videos, and old copies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Platz frei, den Daten von gelöschten Aufnahmen, ungenutzte Kameravideos und alte Kopien belegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez l’espace occupé par les données d’enregistrements disparus, les vidéos de caméra inutilisées et les anciennes copies."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した収録のデータ、使っていないカメラ映像、古いコピーが使っている領域を空けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освободите место, занятое данными удаленных записей, неиспользуемыми видео с камеры и старыми копиями."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звільніть місце, яке займають дані видалених записів, невикористані відео з камери й старі копії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "释放已删除的录制内容的数据、未使用的摄像头视频和旧副本所占用的空间。"
          }
        }
      }
    },
    "Free up space: Settings ▸ Recording ▸ Storage ▸ Clean Up…, History's Clean Up…, and empty the Trash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaff Platz: Einstellungen ▸ Aufzeichnung ▸ Speicher ▸ Aufräumen …, „Aufräumen …“ im Verlauf, und leere den Papierkorb."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez de l’espace : Réglages ▸ Enregistrement ▸ Stockage ▸ Nettoyer…, Nettoyer… dans l’historique, et videz la corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き領域を増やします: “設定”＞“収録”＞“ストレージ”＞“クリーンアップ…”、履歴の“クリーンアップ…”、そしてゴミ箱を空にします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освободите место: Настройки ▸ Запись ▸ Хранилище ▸ Убрать лишнее…, «Убрать лишнее…» в истории, и очистите Корзину."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звільніть місце: Параметри ▸ Запис ▸ Сховище ▸ Прибрати…, «Прибрати…» в історії, і очистьте Смітник."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "释放空间：“设置 ▸ 录制 ▸ 存储空间 ▸ 清理…”、“历史记录”的“清理…”，并清倒废纸篓。"
          }
        }
      }
    },
