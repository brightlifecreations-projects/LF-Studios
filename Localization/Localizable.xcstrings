        }
      }
    },
    "Exports keep going while you edit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte laufen weiter, während du bearbeitest"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exports continuent pendant que vous montez"
