    "After recording, click Restore size to put it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke nach der Aufnahme auf „Größe wiederherstellen“, um sie zurückzusetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’enregistrement, cliquez sur Rétablir la taille pour la remettre comme avant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録が終わったら、“サイズを元に戻す”をクリックして元に戻します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После записи нажмите «Вернуть размер», чтобы вернуть окно как было."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після запису клацніть «Повернути розмір», щоб повернути все як було."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制结束后，点按“恢复大小”让窗口恢复原样。"
          }
        }
      }
    },
    "Afterwards, click Restore size to put the window back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke danach auf „Größe wiederherstellen“, um das Fenster zurückzusetzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, cliquez sur Rétablir la taille pour remettre la fenêtre comme avant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わったら、“サイズを元に戻す”をクリックしてウインドウを元に戻します。"
