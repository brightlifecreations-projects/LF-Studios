    "Set Padding, Radius (rounded corners), and Shadow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell Rand, Radius (abgerundete Ecken) und Schatten ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez Marge, Rayon (coins arrondis) et Ombre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“余白”、“角の丸み”、“シャドウ”を設定します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
