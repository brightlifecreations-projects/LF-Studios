    },
    "Turn your markers into chapters, in the video and for YouTube." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach aus deinen Markern Kapitel – im Video und für YouTube."
          }
