    "LF Studios can't open this file" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios kann diese Datei nicht öffnen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ne peut pas ouvrir ce fichier"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosではこのファイルを開けません"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не может открыть этот файл"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не може відкрити цей файл"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 无法打开此文件"
          }
        }
      }
    },
    "LF Studios can't save to that folder. Pick another place, like Desktop or Movies, and export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios kann nicht in diesem Ordner sichern. Wähle einen anderen Ort, etwa „Schreibtisch“ oder „Filme“, und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ne peut pas enregistrer dans ce dossier. Choisissez un autre emplacement, comme Bureau ou Vidéos, puis exportez à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosはそのフォルダに保存できません。“デスクトップ”や“ムービー”など別の場所を選択して、もう一度書き出してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не может сохранить файл в эту папку. Выберите другое место, например «Рабочий стол» или «Фильмы», и экспортируйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не може зберігати в цю папку. Виберіть інше місце, наприклад «Робочий стіл» чи «Фільми», і експортуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 无法存储到该文件夹。请选择其他位置（如“桌面”或“影片”），然后重新导出。"
          }
        }
      }
    },
    "LF Studios can't write to the save folder. Choose another one in Settings → Screenshots." : {
      "comment" : "Names LF Studios' Settings pane where the save folder is chosen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios kann nicht in den Zielordner schreiben. Wähle einen anderen unter „Einstellungen“ → „Bildschirmfotos“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ne peut pas écrire dans le dossier d’enregistrement. Choisissez-en un autre dans Réglages → Captures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは保存先フォルダに書き込めません。“設定”＞“スクリーンショット”で別のフォルダを選択してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не может записывать в папку для сохранения. Выберите другую в разделе Настройки → Снимки экрана."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не може записувати в папку збереження. Виберіть іншу в розділі Параметри → Знімки екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 无法写入存储文件夹。请在“设置”→“截屏”中选择其他文件夹。"
          }
        }
      }
    },
    "LF Studios checks for a new version once a day. It shows what's new, and installs only when you click Install Update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios sucht einmal am Tag nach einer neuen Version. Es zeigt, was neu ist, und installiert erst, wenn du auf „Update installieren“ klickst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios recherche une nouvelle version une fois par jour. Il montre les nouveautés, et n’installe que si vous cliquez sur Installer la mise à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは1日に1回、新しいバージョンを確認します。新機能が表示され、“アップデートをインストール”をクリックしたときだけインストールされます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios раз в день проверяет, есть ли новая версия. Он показывает, что нового, и устанавливает обновление, только когда вы нажмете «Установить обновление»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios раз на день перевіряє, чи є нова версія. Він показує, що нового, і встановлює її, лише коли ви клацнете «Встановити оновлення»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 每天检查一次新版本。它会显示新功能，只有在你点按“安装更新”时才会安装。"
          }
        }
      }
    },
    "LF Studios could not write the file to:\n%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios konnte die Datei nicht hier sichern:\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios n’a pas pu écrire le fichier à cet emplacement :\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは次の場所にファイルを書き込めませんでした:\n%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не удалось записать файл в это место:\n%@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не вдалося записати файл сюди:\n%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 无法将文件写入：\n%@"
          }
        }
      }
    },
    "LF Studios doesn't find updates" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios findet keine Updates"
          }
        },
