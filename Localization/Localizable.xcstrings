        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Размер» задает толщину линии, а «Размер текста» и «Жирный» — вид текста."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Розмір» задає товщину лінії, а «Розмір тексту» й «Жирний» — вигляд тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用“大小”设定线条粗细，用“文字大小”和“粗体”设定文字。"
          }
        }
      }
    },
    "Use any font on your Mac for captions, title cards, text, and keys, or add your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende jede Schrift auf deinem Mac für Untertitel, Titelkarten, Text und Tasten – oder füge eigene hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez n’importe quelle police de votre Mac pour les sous-titres, les cartons de titre, le texte et les touches, ou ajoutez la vôtre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕、タイトルカード、テキスト、キー表示に、Mac上のどのフォントでも使えます。自分のフォントを追加することもできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте любой шрифт с вашего Mac для субтитров, титров, текста и клавиш или добавьте свой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
