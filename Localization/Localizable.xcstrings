    "Enable LF Studios in System Settings → Privacy & Security → Screen & System Audio Recording, then quit and reopen LF Studios so macOS applies the permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere LF Studios unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Aufnahme von Bildschirm & Systemaudio“. Beende und öffne LF Studios danach erneut, damit macOS die Berechtigung übernimmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez LF Studios dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et des sons du système, puis quittez et rouvrez LF Studios pour que macOS applique l’autorisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システム設定”＞“プライバシーとセキュリティ”＞“画面収録とシステムオーディオ録音”でLF Studiosをオンにしたあと、アクセス許可をmacOSに反映させるためにLF Studiosを終了して再度開いてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Системные настройки → Конфиденциальность и безопасность → Запись экрана и системного звука и включите LF Studios. Затем завершите и снова откройте LF Studios, чтобы разрешение вступило в силу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте Системні параметри → Приватність і безпека → Записування системного звуку й екрана, увімкніть LF Studios, а потім завершіть і знову відкрийте LF Studios, щоб дозвіл набув чинності."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”→“隐私与安全性”→“录屏与系统录音”中启用 LF Studios，然后退出并重新打开 LF Studios，以便 macOS 应用该权限。"
          }
        }
      }
    },
    "Enable LF Studios in System Settings, then relaunch so macOS applies it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere LF Studios in den Systemeinstellungen und starte es dann neu, damit macOS die Berechtigung übernimmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez LF Studios dans Réglages Système, puis relancez-le pour que macOS en tienne compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“システム設定”でLF Studiosをオンにしたあと、macOSに反映させるためにLF Studiosを再度開いてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите LF Studios в Системных настройках и перезапустите приложение, чтобы разрешение вступило в силу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть LF Studios у Системних параметрах, а потім перезапустіть програму, щоб дозвіл набув чинності."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”中启用 LF Studios，然后退出并重新打开，以便 macOS 应用更改。"
          }
        }
      }
    },
