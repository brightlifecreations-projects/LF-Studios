    "Make your camera look its best: brighter, warmer, or more cinematic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass deine Kamera so gut wie möglich aussehen: heller, wärmer oder filmischer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez votre caméra en valeur : plus lumineuse, plus chaude ou plus cinéma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラの映りをよくします: 明るく、暖かく、または映画のように。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть камера выглядит лучше всего: светлее, теплее или кинематографичнее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нехай камера показує вас якнайкраще: яскравіше, тепліше чи кінематографічніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让摄像头画面呈现最佳状态：更明亮、更温暖，或更有电影感。"
          }
        }
      }
    },
    "Make your recording exactly 1920 × 1080 (or another size) without guessing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring deine Aufnahme genau auf 1920 × 1080 (oder eine andere Größe), ohne zu raten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez un enregistrement d’exactement 1920 × 1080 (ou une autre taille) sans tâtonner."
