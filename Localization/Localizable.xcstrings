        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をマイスタイルにしました — 「マイスタイルを適用」（⇧⌘Y）でビデオに適用できます"
          }
        },
        "ru" : {
          "stringUnit" : {
