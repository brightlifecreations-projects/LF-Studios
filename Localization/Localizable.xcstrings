    "Show me only opens the right place; it never changes a setting or turns anything on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zeig’s mir“ öffnet nur die richtige Stelle; es ändert nie eine Einstellung und schaltet nichts ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me montrer ouvre seulement le bon endroit ; il ne modifie jamais un réglage et n’active jamais rien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“見てみる”は該当する場所を開くだけです。設定を変更したり、何かをオンにしたりすることはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Показать» только открывает нужное место — никогда не меняет настройки и ничего не включает."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
