    "After changing the shape, move zooms, the camera, and captions so everything fits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschieb nach dem Ändern der Form Zooms, Kamera und Untertitel, damit alles passt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir changé la forme, déplacez les zooms, la caméra et les sous-titres pour que tout tienne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形を変更したあとで、すべてが収まるようにズーム、カメラ、字幕を移動します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После смены формата переместите увеличения, камеру и субтитры, чтобы все поместилось."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після зміни формату перемістіть наближення, камеру й субтитри, щоб усе вмістилося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改画面比例后，移动缩放、摄像头和字幕，让一切都合适。"
          }
        }
      }
    },
    "After recording" : {
