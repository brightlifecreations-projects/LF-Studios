    "Show keyboard shortcuts" : {
      "comment" : "Recording bar toggle: shows the shortcuts pressed while recording as keycaps",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturkurzbefehle anzeigen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les raccourcis clavier"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードショートカットを表示"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать сочетания клавиш"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати клавіатурні скорочення"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示快捷键"
          }
        }
      }
    },
    "Show keyboard shortcuts: only shortcuts with ⌘ or ⌃ (like ⌘C), and keys like Esc. Never ordinary typing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturkurzbefehle anzeigen: nur Kurzbefehle mit ⌘ oder ⌃ (wie ⌘C) und Tasten wie Esc. Nie normales Tippen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les raccourcis clavier : seulement les raccourcis avec ⌘ ou ⌃ (comme ⌘C), et des touches comme Esc. Jamais la saisie ordinaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“キーボードショートカットを表示”: ⌘や⌃を使ったショートカット（⌘Cなど）とEscなどのキーだけを保存します。通常の文字入力は保存されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Показывать сочетания клавиш»: только сочетания с ⌘ или ⌃ (например, ⌘C) и клавиши вроде Esc. Никогда обычный ввод текста."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Показувати клавіатурні скорочення»: лише скорочення з ⌘ чи ⌃ (як-от ⌘C) і клавіші на кшталт Esc. Ніколи звичайний набір тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示快捷键：只记录带 ⌘ 或 ⌃ 的快捷键（例如 ⌘C），以及 Esc 等按键。绝不记录普通打字。"
          }
        }
      }
    },
    "Show me" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig’s mir"
