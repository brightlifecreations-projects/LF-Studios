    },
    "Reframes zooms, moves the camera bubble, and keeps captions in the safe area for %@. This ratio then keeps its own version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richtet Zooms neu aus, verschiebt die Kamerablase und hält Untertitel im sicheren Bereich für %@. Dieses Format behält dann seine eigene Fassung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recadre les zooms, déplace la bulle de caméra et garde les sous-titres dans la zone sûre pour le %@. Ce format garde ensuite sa propre version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@向けにズームを組み直し、カメラのバブルを動かし、字幕をセーフエリアに収めます。以後この比率は専用のバージョンを持ちます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перестраивает зумы, двигает пузырь камеры и держит субтитры в безопасной зоне для %@. Затем у этого формата будет своя версия."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перебудовує зуми, пересуває бульбашку камери й тримає субтитри в безпечній зоні для %@. Далі цей формат матиме власну версію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 %@ 重新取景缩放、移动摄像头气泡，并让字幕保持在安全区内。此后该比例会保留自己的版本。"
          }
        }
      }
    },
    "Regular" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準"
          }
        },
        "ru" : {
