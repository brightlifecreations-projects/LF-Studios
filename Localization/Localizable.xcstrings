            "state" : "translated",
            "value" : "录制 %@ × %@ 像素（%@ × %@ 点）"
          }
        }
      }
    },
    "Records the pointer separately, so the editor can smooth it, resize it, and keep it crisp when zoomed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet den Zeiger separat auf, damit der Editor ihn glätten, skalieren und beim Zoomen scharf halten kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre le pointeur séparément, pour que l’éditeur puisse le lisser, le redimensionner et le garder net en cas de zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタを別途収録するため、エディタでポインタの動きを滑らかにしたり、サイズを変更したり、ズームしてもくっきり表示したりできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает указатель отдельно, чтобы редактор мог сглаживать его, менять размер и сохранять четкость при увеличении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записує курсор окремо, щоб редактор міг згладжувати його, змінювати розмір і зберігати чіткість під час наближення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独录制指针，以便编辑器平滑指针、调整其大小，并在缩放时保持清晰。"
          }
        }
      }
    },
