    "Framing: Follow cursor follows the pointer; Aim by hand lets you drag the frame on the preview; Follow typing follows your typing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildausschnitt: „Zeiger folgen“ folgt dem Zeiger; mit „Von Hand ausrichten“ ziehst du den Rahmen in der Vorschau; „Tippen folgen“ folgt deinem Tippen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadrage : Suivre le pointeur suit le pointeur ; Viser à la main vous permet de faire glisser le cadre sur l’aperçu ; Suivre la saisie suit votre saisie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“フレーミング”: “ポインタに追従”はポインタを追いかけ、“手動で位置を指定”ではプレビュー上で枠をドラッグでき、“入力に追従”は入力している場所を追いかけます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Кадрирование»: «За указателем» следует за указателем; «Вручную» позволяет перетащить рамку в предпросмотре; «За набором» следует за набором текста."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Кадрування»: «Стежити за курсором» стежить за курсором; «Навести вручну» дає змогу тягнути рамку на перегляді; «Стежити за набором» стежить за вашим набором тексту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取景：“跟随指针”会跟随指针移动；“手动对准”可让你在预览上拖移取景框；“跟随打字”会跟随你打字的位置。"
          }
        }
      }
    },
