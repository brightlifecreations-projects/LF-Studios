    "Your narration can become captions — then cut the video by editing its words." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kommentar kann Untertitel werden – dann schneidest du das Video per Text."
          }
        },
        "fr" : {
