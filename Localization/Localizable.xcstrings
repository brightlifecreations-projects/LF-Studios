    "Whisper runs on this Mac. The model is downloaded once from Hugging Face; your recording is never uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper läuft auf diesem Mac. Das Modell wird einmal von Hugging Face geladen; deine Aufnahme wird nie hochgeladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper fonctionne sur ce Mac. Le modèle est téléchargé une fois depuis Hugging Face ; votre enregistrement n’est jamais envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhisperはこのMac上で動きます。モデルはHugging Faceから一度だけダウンロードされ、録画がアップロードされることはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper работает на этом Mac. Модель загружается с Hugging Face один раз; запись никуда не отправляется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper працює на цьому Mac. Модель завантажується з Hugging Face один раз; запис нікуди не надсилається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper 在此 Mac 上运行。模型只需从 Hugging Face 下载一次；你的录制内容绝不会上传。"
          }
        }
      }
    },
