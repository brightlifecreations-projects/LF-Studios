    },
    "The timeline is empty. Restore a clip, then export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeitleiste ist leer. Stelle einen Clip wieder her und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La timeline est vide. Restaurez un clip, puis exportez à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムラインが空です。クリップを復元してから、もう一度書き出してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шкала времени пуста. Восстановите клип и экспортируйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шкала часу порожня. Відновіть кліп, а потім експортуйте ще раз."
          }
