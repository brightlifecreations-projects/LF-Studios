    },
    "The bubble you see while recording never shows up in the screen recording itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Blase, die du beim Aufzeichnen siehst, erscheint nie in der Bildschirmaufnahme selbst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bulle que vous voyez pendant l’enregistrement n’apparaît jamais dans l’enregistrement de l’écran lui-même."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録中に表示されるワイプが、画面収録そのものに映ることはありません。"
