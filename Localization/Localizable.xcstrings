    },
    "Your screenshot is saved in History and in Home ▸ Screenshots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Bildschirmfoto wird im Verlauf und unter Start ▸ Bildschirmfotos gesichert."
          }
        },
        "fr" : {
          "stringUnit" : {
