    "Microphone access is off, so this recording has no mic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist deaktiviert, daher hat diese Aufnahme keinen Mikrofonton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est désactivé : cet enregistrement n’aura pas de son du micro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスがオフのため、この収録にはマイクの音声が入りません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону выключен, поэтому запись идет без микрофона."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до мікрофона вимкнено, тому в цьому записі немає звуку з мікрофона."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问权限已关闭，因此本次录制不含麦克风声音。"
          }
        }
      }
    },
    "Microphone access is off. Allow LF Studios in System Settings → Privacy & Security → Microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist deaktiviert. Erlaube LF Studios unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Mikrofon“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est désactivé. Autorisez LF Studios dans Réglages Système → Confidentialité et sécurité → Micro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスがオフになっています。“システム設定”＞“プライバシーとセキュリティ”＞“マイク”でLF Studiosを許可してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону выключен. Разрешите его для LF Studios в разделе Системные настройки → Конфиденциальность и безопасность → Микрофон."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до мікрофона вимкнено. Дозвольте його для LF Studios: Системні параметри → Приватність і безпека → Мікрофон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问权限已关闭。请在“系统设置”→“隐私与安全性”→“麦克风”中允许 LF Studios。"
          }
        }
      }
    },
    "Microphone disconnected. Now recording from %@." : {
      "comment" : "The microphone now used",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon getrennt. Die Aufzeichnung läuft jetzt über „%@“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micro déconnecté. L’enregistrement utilise maintenant « %@ »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクの接続が解除されました。現在は“%@”で録音しています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон отключен. Теперь запись идет с устройства «%@»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мікрофон від’єднано. Тепер запис іде з «%@»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已断开连接。现在使用“%@”录音。"
          }
        }
      }
    },
    "Microphone disconnected. The recording continues without it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon getrennt. Die Aufzeichnung läuft ohne Mikrofon weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micro déconnecté. L’enregistrement continue sans lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクの接続が解除されました。マイクなしで収録を続けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон отключен. Запись продолжается без него."
          }
        },
        "uk" : {
          "stringUnit" : {
