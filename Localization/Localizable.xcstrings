    "Bring captions to life: words that pop in, a karaoke fill, a typewriter, and more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring Leben in die Untertitel: aufploppende Wörter, Karaoke-Füllung, Schreibmaschine und mehr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez vie aux sous-titres : mots qui apparaissent, remplissage karaoké, machine à écrire, et plus encore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕に動きを付けます: ポップインする単語、カラオケ塗り、タイプライターなど。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оживите субтитры: всплывающие слова, караоке-заливка, печатная машинка и не только."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оживіть субтитри: слова, що вискакують, караоке-заливка, друкарська машинка тощо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让字幕更生动：弹出的字词、卡拉 OK 填充、打字机效果等。"
          }
        }
      }
    },
