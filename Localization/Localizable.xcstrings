    },
    "Right-click for Open, Show in Finder, Creative Handoff…, or Delete (moves it to the Trash)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Rechtsklick findest du „Öffnen“, „Im Finder zeigen“, „Kreative Übergabe …“ und „Löschen“ (legt es in den Papierkorb)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic droit pour Ouvrir, Afficher dans le Finder, Transmission créative… ou Supprimer (le place dans la corbeille)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右クリックすると、“開く”、“Finderに表示”、“クリエイティブ受け渡し…”、“削除”（ゴミ箱に移動）を選べます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правой кнопкой мыши — «Открыть», «Показать в Finder», «Творческая передача…» или «Удалить» (перемещает в Корзину)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть правою кнопкою, щоб вибрати «Відкрити», «Показати у Finder», «Творче передавання…» або «Видалити» (переносить у Смітник)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按可选择“打开”“在‘访达’中显示”“创意交付…”或“删除”（移到废纸篓）。"
          }
        }
      }
    },
    "Right-click for Save As…, Pin to Screen, and Delete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Rechtsklick findest du „Sichern unter …“, „Auf dem Bildschirm anheften“ und „Löschen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic droit pour Enregistrer sous…, Épingler à l’écran et Supprimer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右クリックすると、“別名で保存…”、“画面に固定”、“削除”を選べます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правой кнопкой мыши — «Сохранить как…», «Закрепить на экране» и «Удалить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть правою кнопкою, щоб вибрати «Зберегти як…», «Закріпити на екрані» або «Видалити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按可选择“存储为…”“贴到屏幕”和“删除”。"
          }
        }
      }
    },
    "Right-click it for Copy, Save As…, Edit, Close Pin, or Close All Pins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Rechtsklick findest du „Kopieren“, „Sichern unter …“, „Bearbeiten“, „Schließen“ und „Alle schließen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic droit dessus pour Copier, Enregistrer sous…, Modifier, Fermer ou Tout fermer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右クリックすると、“コピー”、“別名で保存…”、“編集”、“閉じる”、“すべて閉じる”を選べます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правой кнопкой мыши — «Скопировать», «Сохранить как…», «Правка», «Закрыть» или «Закрыть все»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть правою кнопкою, щоб вибрати «Скопіювати», «Зберегти як…», «Редагувати», «Закрити» або «Закрити всі»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按它可选择“拷贝”“存储为…”“编辑”“关闭贴图”或“关闭所有贴图”。"
          }
        }
      }
    },
