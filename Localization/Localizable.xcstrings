          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“表示”で、元の字幕と翻訳を切り替えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С помощью «Показывать» переключайтесь между оригиналом и переводом."
