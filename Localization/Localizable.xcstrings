    "The pointer glides back to where it started at the end, so the video loops without a jump." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeiger gleitet am Ende zurück zum Startpunkt, sodass das Video ohne Sprung in Schleife läuft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pointeur revient en glissant à son point de départ à la fin, pour que la vidéo boucle sans saut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後にポインタが開始位置へ滑らかに戻るので、ビデオが途切れずにループします。"
          }
