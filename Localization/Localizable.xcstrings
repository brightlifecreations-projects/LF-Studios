    "Use music you have the rights to. Click the music lane on the timeline to get back here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Musik, für die du die Rechte hast. Klicke auf die Musikspur der Zeitleiste, um hierher zurückzukommen."
          }
        },
        "fr" : {
          "stringUnit" : {
