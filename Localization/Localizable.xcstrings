    "Open Settings ▸ Shortcuts and check that the shortcut has keys. Recording shortcuts start unset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Einstellungen ▸ Kurzbefehle und prüf, ob der Kurzbefehl Tasten hat. Kurzbefehle für Aufzeichnungen sind anfangs nicht belegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Réglages ▸ Raccourcis et vérifiez que le raccourci a des touches. Les raccourcis d’enregistrement ne sont pas définis au départ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“設定”＞“ショートカット”を開き、ショートカットにキーが設定されていることを確認します。収録のショートカットは、最初は設定されていません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Настройки ▸ Сочетания и проверьте, что у сочетания есть клавиши. Сочетания для записи сначала не заданы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте Параметри ▸ Скорочення й перевірте, що скороченню призначено клавіші. Скорочення для запису спершу не задані."
          }
        },
        "zh-Hans" : {
