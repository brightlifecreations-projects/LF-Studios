          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドでは、プロジェクトを名前で、スクリーンショットをテキストで検索できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
