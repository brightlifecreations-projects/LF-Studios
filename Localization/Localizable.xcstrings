    "The markers are already at clip edges" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Marker liegen schon an Clipgrenzen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les marqueurs sont déjà aux bords des clips"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マーカーはすでにクリップの境目にあります"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маркеры уже стоят на границах клипов"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маркери вже стоять на межах кліпів"
          }
