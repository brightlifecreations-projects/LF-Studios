    "Your disk is full, so the recording couldn't be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Speicher ist voll, daher konnte die Aufnahme nicht gesichert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre disque est plein : l’enregistrement n’a pas pu être sauvegardé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクがいっぱいのため、収録を保存できませんでした。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск заполнен, поэтому запись не удалось сохранить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск заповнено, тому не вдалося зберегти запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘已满，无法存储录制内容。"
          }
        }
      }
    },
    "Your disk is full. Free up some space (empty the Trash, delete old recordings) or export to another drive, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Festplatte ist voll. Gib Speicherplatz frei (Papierkorb leeren, alte Aufnahmen löschen) oder exportiere auf ein anderes Laufwerk und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre disque est plein. Libérez de l’espace (videz la corbeille, supprimez d’anciens enregistrements) ou exportez vers un autre disque, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクがいっぱいです。空き容量を増やす（ゴミ箱を空にする、古い収録を削除するなど）か、別のドライブに書き出してから、もう一度お試しください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск заполнен. Освободите место (очистите Корзину, удалите старые записи) или экспортируйте на другой диск и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диск заповнено. Звільніть місце (очистіть Кошик, видаліть старі записи) або експортуйте на інший диск, а потім спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的磁盘已满。请释放一些空间（清倒废纸篓、删除旧的录制内容）或导出到其他磁盘，然后重试。"
          }
        }
      }
    },
    "Your edits will be lost if you close without saving or copying them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen gehen verloren, wenn du schließt, ohne sie zu sichern oder zu kopieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications seront perdues si vous fermez sans les enregistrer ni les copier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存またはコピーせずに閉じると、編集内容は失われます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши изменения будут потеряны, если закрыть окно, не сохранив и не скопировав их."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо закрити, не зберігши й не скопіювавши зміни, їх буде втрачено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果关闭前不存储或拷贝，你的编辑将会丢失。"
          }
        }
      }
    },
