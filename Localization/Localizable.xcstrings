    },
    "Set Size and Opacity. Turn on Show for the whole video for a watermark." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell Größe und Deckkraft ein. Für ein Wasserzeichen schalte „Im ganzen Video zeigen“ ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez Taille et Opacité. Activez Afficher pendant toute la vidéo pour un filigrane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“サイズ”と“不透明度”を設定します。透かしにするには、“ビデオ全体で表示”をオンにします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте «Размер» и «Непрозрачность». Для водяного знака включите «Показывать все время»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте «Розмір» і «Непрозорість». Для водяного знака ввімкніть «Показувати протягом усього відео»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定“大小”和“不透明度”。要用作水印，请打开“在整个视频中显示”。"
          }
        }
      }
    },
    "Set Smoothness (how calmly it follows) and Framing (how close it is)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell „Gleichmäßigkeit“ (wie ruhig es folgt) und „Bildausschnitt“ (wie nah es ist) ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez Fluidité (avec quel calme elle suit) et Cadrage (à quelle distance)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“なめらかさ”（どれだけ穏やかに追いかけるか）と“フレーミング”（どれだけ寄るか）を設定します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте «Плавность» (насколько спокойно окошко следует) и «Кадрирование» (насколько близко)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте «Плавність» (наскільки спокійно бульбашка стежить) і «Кадрування» (наскільки близько)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定“平滑度”（跟随得有多平稳）和“取景”（拉得有多近）。"
          }
        }
      }
    },
    "Set how loud your voice and your Mac's sound are, or mute the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell ein, wie laut deine Stimme und der Ton deines Macs sind, oder schalte das Video stumm."
          }
        },
        "fr" : {
