    "Zoom level: how close it goes. Use this level for every zoom applies it to all." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomstufe: wie nah er herangeht. „Diese Stufe für alle Zooms verwenden“ überträgt sie auf alle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveau de zoom : à quel point il se rapproche. Utiliser ce niveau pour tous les zooms l’applique à tous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ズーム倍率”: どれだけ近づくか。“この倍率をすべてのズームに適用”で、すべてのズームに適用します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Уровень увеличения»: насколько близко. «Для всех увеличений» применяет его ко всем."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
