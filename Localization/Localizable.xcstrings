    "Recordings in the Trash or on a drive that isn't plugged in keep their data. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen im Papierkorb oder auf einem nicht angeschlossenen Laufwerk behalten ihre Daten. Dies kann nicht widerrufen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements placés dans la corbeille ou sur un disque non branché conservent leurs données. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱内の収録や、接続されていないドライブ上の収録のデータは残ります。この操作は取り消せません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи в Корзине или на неподключенном диске сохранят свои данные. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи в Кошику або на непід’єднаному диску зберігають свої дані. Цю дію не можна відмінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "废纸篓中或未连接磁盘上的录制内容会保留其数据。此操作无法撤销。"
          }
        }
      }
    },
    "Recordings made with LF Studios capture the pointer so it can be smoothed, resized, and hidden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit LF Studios erstellte Aufnahmen zeichnen den Zeiger separat auf, damit er geglättet, vergrößert und ausgeblendet werden kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements réalisés avec LF Studios capturent le pointeur pour qu’il puisse être lissé, redimensionné et masqué."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosで収録したビデオではポインタが別に記録されるため、滑らかにしたり、サイズを変えたり、非表示にしたりできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи, сделанные в LF Studios, сохраняют указатель отдельно, чтобы его можно было сгладить, увеличить или скрыть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи, зроблені в LF Studios, зберігають курсор окремо, тож його можна згладити, змінити розмір чи сховати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 LF Studios 录制的内容会单独捕捉指针，以便平滑、调整大小和隐藏。"
          }
        }
      }
    },
    "Records %@ × %@ pixels (%@ × %@ points)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet %@ × %@ Pixel auf (%@ × %@ Punkte)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre %@ × %@ pixels (%@ × %@ points)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ × %@ピクセル（%@ × %@ポイント）を収録します"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
