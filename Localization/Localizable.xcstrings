    "Turn on Camera in the recording bar. macOS asks once: click Allow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in der Aufzeichnungsleiste „Kamera“ ein. macOS fragt einmal: Klicke auf „Erlauben“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Caméra dans la barre d’enregistrement. macOS le demande une fois : cliquez sur Autoriser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録バーで“カメラ”をオンにします。macOSが一度だけ確認するので、“許可”をクリックします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Камера» на панели записи. macOS спросит один раз — нажмите «Разрешить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Камера» на панелі запису. macOS запитає один раз: клацніть «Дозволити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在录制栏中打开“摄像头”。macOS 会询问一次：点按“允许”。"
          }
        }
      }
    },
    "Turn on Camera. A bubble with your face appears; it's recorded separately, so you can move and restyle it later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „Kamera“ ein. Eine Blase mit deinem Gesicht erscheint. Sie wird separat aufgezeichnet, du kannst sie also später verschieben und neu gestalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Caméra. Une bulle avec votre visage apparaît ; elle est enregistrée à part, vous pourrez donc la déplacer et changer son style plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“カメラ”をオンにします。顔が映ったワイプが表示されます。ワイプは別に収録されるので、あとから移動したりスタイルを変えたりできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Камера». Появится окошко с вашим лицом; оно записывается отдельно, поэтому позже его можно переместить и оформить иначе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Камера». З’явиться бульбашка з вашим обличчям; вона записується окремо, тож згодом її можна перемістити й змінити її стиль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“摄像头”，会出现一个显示你面部的气泡；它是单独录制的，所以之后还可以移动它、更改样式。"
          }
        }
      }
    },
    "Turn on Camera. A round bubble appears; drag it where you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „Kamera“ ein. Eine runde Blase erscheint; zieh sie, wohin du willst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Caméra. Une bulle ronde apparaît ; faites-la glisser où vous voulez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“カメラ”をオンにします。丸いワイプが表示されるので、好きな場所にドラッグします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Камера». Появится круглое окошко — перетяните его куда нужно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Камера». З’явиться кругла бульбашка — перетягніть її куди завгодно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“摄像头”，会出现一个圆形气泡；把它拖到你喜欢的位置。"
          }
        }
      }
    },
    "Turn on Intro card or Outro card." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „Intro-Karte“ oder „Outro-Karte“ ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Carton d’intro ou Carton de fin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“オープニングカード”または“エンディングカード”をオンにします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Начальный титр» или «Финальный титр»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Вступна заставка» чи «Завершальна заставка»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“片头卡”或“片尾卡”。"
          }
        }
      }
    },
    "Turn on Keep face centered. LF Studios looks for your face once, with progress and Cancel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „Gesicht zentriert halten“ ein. LF Studios sucht einmal nach deinem Gesicht, mit Fortschrittsanzeige und „Abbrechen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Garder le visage centré. LF Studios recherche votre visage une fois, avec une barre de progression et Annuler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“顔を中央に保つ”をオンにします。LF Studiosが一度だけ顔を探します。その間は進行状況と“キャンセル”が表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Держать лицо по центру». LF Studios один раз найдет ваше лицо — с индикатором хода и кнопкой «Отменить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Тримати обличчя в центрі». LF Studios один раз шукає ваше обличчя — з індикатором поступу й кнопкою «Скасувати»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“保持面部居中”。LF Studios 会查找一次你的脸，并显示进度和“取消”按钮。"
          }
        }
      }
    },
    "Turn on Microphone in the recording bar. macOS asks once: click Allow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in der Aufzeichnungsleiste „Mikrofon“ ein. macOS fragt einmal: Klicke auf „Erlauben“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Micro dans la barre d’enregistrement. macOS le demande une fois : cliquez sur Autoriser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録バーで“マイク”をオンにします。macOSが一度だけ確認するので、“許可”をクリックします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Микрофон» на панели записи. macOS спросит один раз — нажмите «Разрешить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Мікрофон» на панелі запису. macOS запитає один раз: клацніть «Дозволити»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在录制栏中打开“麦克风”。macOS 会询问一次：点按“允许”。"
          }
        }
      }
    },
    "Turn on Microphone." : {
