        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл субтитров для YouTube и веб-плееров (.srt) или для веба (.vtt) — учитывает ваш монтаж"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл субтитрів для YouTube і вебплеєрів (.srt) або для вебу (.vtt) — враховує ваші вирізання"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于 YouTube 和网页播放器（.srt）或网页（.vtt）的字幕文件 — 跟随你的剪辑"
