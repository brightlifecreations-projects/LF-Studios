    "Hide when idle hides the pointer while it rests; Hide the move to Stop hides the trip to the stop button at the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bei Stillstand ausblenden“ blendet den Zeiger aus, solange er ruht; „Weg zu ‚Stoppen‘ ausblenden“ verbirgt am Ende den Weg zur Stopptaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer à l’arrêt masque le pointeur quand il est immobile ; Masquer le trajet vers Arrêter masque le trajet vers le bouton d’arrêt à la fin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“静止中は非表示”では止まっている間はポインタを隠し、「“停止”への移動を非表示」では最後に停止ボタンへ向かう動きを隠します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Скрывать при бездействии» прячет указатель, пока он неподвижен; «Скрыть движение к кнопке „Остановить“» прячет путь к кнопке остановки в конце."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ховати в спокої» ховає курсор, поки він нерухомий; «Сховати рух до „Зупинити“» ховає шлях до кнопки зупинки наприкінці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“静止时隐藏”会在指针静止时将其隐藏；“隐藏移向‘停止’的动作”会隐藏结尾时指针移向停止按钮的过程。"
          }
        }
      }
    },
