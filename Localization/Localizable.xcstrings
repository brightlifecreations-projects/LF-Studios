    "Accuracy: Accurate reads more carefully; Fast is quicker but knows fewer languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauigkeit: „Genau“ liest sorgfältiger; „Schnell“ ist flotter, kennt aber weniger Sprachen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Précision : Précise lit plus attentivement ; Rapide va plus vite mais connaît moins de langues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精度: “正確”はより丁寧に読み取ります。“高速”は速いですが、対応する言語が少なくなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Режим»: «Точный» читает внимательнее; «Быстрый» работает быстрее, но знает меньше языков."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Точність»: «Точне» читає уважніше; «Швидке» працює швидше, але знає менше мов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准确度：“精确”识别得更仔细；“快速”速度更快，但支持的语言较少。"
          }
        }
      }
    },
