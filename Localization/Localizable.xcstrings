    "Your marks stay editable. Reset shows the whole screenshot again, and ⌘Z undoes a crop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Beschriftungen bleiben bearbeitbar. „Zurücksetzen“ zeigt wieder das ganze Bildschirmfoto, und ⌘Z widerruft das Beschneiden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos annotations restent modifiables. Réinitialiser réaffiche toute la capture, et ⌘Z annule un rognage."
