    "Select a caption on the timeline to change when it starts and ends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Untertitel auf der Zeitleiste aus, um zu ändern, wann er beginnt und endet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un sous-titre sur la timeline pour changer son début et sa fin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムラインで字幕を選択すると、始まりと終わりのタイミングを変更できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите субтитр на шкале времени, чтобы изменить, когда он начинается и заканчивается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть субтитр на шкалі часу, щоб змінити, коли він починається й закінчується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在时间线上选中一条字幕，即可更改它开始和结束的时间。"
          }
        }
      }
    },
    "Select a clip for Mute this clip, Fade in, and Fade out. Or ⇧-drag a part and choose Mute this part." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Clip aus für „Diesen Clip stummschalten“, „Einblenden“ und „Ausblenden“. Oder zieh mit ⇧ über einen Abschnitt und wähle „Diesen Abschnitt stummschalten“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un clip pour Couper le son de ce clip, Fondu d’entrée et Fondu de sortie. Ou sélectionnez un passage avec ⇧ en faisant glisser et choisissez Couper le son de ce passage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップを選択すると、“このクリップを消音”、“フェードイン”、“フェードアウト”が使えます。または、⇧キーを押しながら範囲をドラッグして“この部分を消音”を選びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите клип, чтобы увидеть «Выключить звук этого клипа», «Нарастание» и «Затухание». Или выделите фрагмент, проведя с ⇧, и выберите «Выключить звук этого фрагмента»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть кліп, щоб побачити «Вимкнути звук цього кліпу», «Поява» й «Зникнення». Або виділіть частину, перетягнувши з ⇧, і виберіть «Вимкнути звук цієї частини»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个片段，可使用“将此片段静音”“淡入”和“淡出”。或者按住 ⇧ 拖移选出一段，然后选择“将此部分静音”。"
          }
        }
      }
    },
    "Select a clip on the timeline to mute it or fade it in and out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Clip in der Zeitleiste aus, um ihn stummzuschalten oder ein- und auszublenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un clip dans la timeline pour couper son son ou lui appliquer un fondu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムラインでクリップを選択すると、消音やフェードイン/フェードアウトを設定できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите клип на шкале времени, чтобы выключить его звук или настроить нарастание и затухание."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть кліп на шкалі часу, щоб вимкнути його звук або додати плавну появу й зникнення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在时间线上选择一个片段即可将其静音或设置淡入淡出。"
          }
        }
      }
    },
    "Select a clip, or ⇧-drag a part, and choose its Speed in the panel on the right." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Clip aus oder zieh mit ⇧ über einen Abschnitt und wähle im Panel rechts sein Tempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un clip, ou un passage avec ⇧ en faisant glisser, et choisissez sa Vitesse dans le panneau de droite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップを選択するか、⇧キーを押しながら範囲をドラッグして、右側のパネルで“速度”を選びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
