    "Click the notice to open the recovered video. Pointer, click, and marker details from that take can't be recovered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf die Mitteilung, um das wiederhergestellte Video zu öffnen. Zeiger-, Klick- und Markerdaten aus dieser Aufnahme lassen sich nicht wiederherstellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur le message pour ouvrir la vidéo récupérée. Les données de pointeur, de clics et de marqueurs de cette prise ne peuvent pas être récupérées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知をクリックすると、復元したビデオが開きます。そのテイクのポインタ、クリック、マーカーの情報は復元できません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на уведомление, чтобы открыть восстановленное видео. Данные об указателе, нажатиях и маркерах из этого дубля восстановить нельзя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть повідомлення, щоб відкрити відновлене відео. Дані про курсор, клацання й маркери з цього дубля відновити не вдасться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按提示即可打开恢复的视频。那次录制中的指针、点按和标记信息无法恢复。"
          }
        }
      }
    },
