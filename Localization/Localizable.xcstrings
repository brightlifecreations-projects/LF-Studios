          "stringUnit" : {
            "state" : "translated",
            "value" : "Die höchste Qualität und die einzige, die Transparenz behalten kann"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La meilleure qualité, et la seule qui peut garder la transparence"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高画質で、透明部分を保てる唯一のフォーマットです"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самое высокое качество — и единственный формат, который сохраняет прозрачность"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найвища якість — і єдиний формат, що зберігає прозорість"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高画质，也是唯一能保留透明度的格式"
          }
        }
      }
    },
    "The loupe stays over the text cursor." : {
      "localizations" : {
