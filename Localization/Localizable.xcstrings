    "This Mac can't translate between these languages. Pick another language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann nicht zwischen diesen Sprachen übersetzen. Wähle eine andere Sprache."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne peut pas traduire entre ces langues. Choisissez une autre langue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacではこれらの言語間で翻訳できません。別の言語を選択してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac не может переводить между этими языками. Выберите другой язык."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей Mac не може перекладати між цими мовами. Виберіть іншу мову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 无法在这两种语言之间翻译。请选择其他语言。"
          }
        }
      }
    },
    "This Mac has no ProRes chip, so the re-encoded files take a while — the progress shows how long." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac hat keinen ProRes-Chip, die neu codierten Dateien dauern deshalb eine Weile – der Fortschritt zeigt, wie lange."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac n’a pas de puce ProRes : les fichiers réencodés prennent un moment — la progression indique combien de temps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacにはProResチップがないため、再エンコードするファイルには時間がかかります。進行状況に所要時間が表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом Mac нет чипа ProRes, поэтому перекодирование займёт время — сколько, покажет индикатор."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
