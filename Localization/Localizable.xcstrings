          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считайте QR-код или штрихкод на экране: откройте ссылку, напишите письмо или посмотрите пароль Wi-Fi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитайте QR-код чи штрихкод на екрані: відкрийте посилання, напишіть лист або подивіться пароль Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
