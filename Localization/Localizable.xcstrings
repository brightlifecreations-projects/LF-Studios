    "Side rail, Full rail, or Minimal. It shows only in the preview, never in the export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitenleiste, Volle Leiste oder Minimal. Es erscheint nur in der Vorschau, nie im Export."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colonne latérale, Colonne complète ou Minimal. Elle n’apparaît que dans l’aperçu, jamais dans l’export."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“サイドレール”、“フルレール”、“ミニマル”。プレビューにだけ表示され、書き出したビデオには入りません。"
