    "YouTube needs every chapter to be at least 10 seconds long — move or remove markers that are closer together." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube braucht Kapitel von mindestens 10 Sekunden – verschiebe oder entferne Marker, die zu nah beieinanderliegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube exige que chaque chapitre dure au moins 10 secondes — déplacez ou supprimez les marqueurs trop rapprochés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTubeではチャプターごとに10秒以上が必要です — 近すぎるマーカーを移動するか削除してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube нужно, чтобы каждая глава длилась не меньше 10 секунд, — передвиньте или удалите слишком близкие маркеры."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube потребує, щоб кожен розділ тривав щонайменше 10 секунд, — пересуньте або видаліть надто близькі маркери."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube 要求每个章节至少 10 秒 — 请移动或移除靠得太近的标记。"
          }
        }
      }
    },
    "YouTube shows chapters from 3 on — add a marker or two more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube zeigt Kapitel ab 3 Stück – setze noch ein, zwei Marker."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube affiche les chapitres à partir de 3 — ajoutez un ou deux marqueurs de plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTubeでは3つ以上でチャプターが表示されます — マーカーをあと1〜2個追加してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube показывает главы, когда их хотя бы 3, — добавьте ещё один-два маркера."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube показує розділи, коли їх щонайменше 3, — додайте ще один-два маркери."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube 至少需要 3 个章节才会显示 — 请再添加一两个标记。"
          }
        }
      }
    },
