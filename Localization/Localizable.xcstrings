    "%@ is too much for this Mac and would be very slow or fail. Try %@ instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist zu viel für diesen Mac und wäre sehr langsam oder würde scheitern. Versuch stattdessen %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est trop lourd pour ce Mac : ce serait très lent ou échouerait. Essayez plutôt %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はこのMacには重すぎて、とても遅いか失敗します。代わりに%@をお試しください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ слишком тяжела для этого Mac: будет очень медленно или не получится. Попробуйте %@."
