    "Leaves out the background: the video, its rounded corners and shadow, and a cut-out camera sit on transparency, ready to place over anything" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt den Hintergrund weg: Das Video mit seinen abgerundeten Ecken und dem Schatten und eine freigestellte Kamera liegen auf Transparenz – bereit, über alles gelegt zu werden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire l’arrière-plan : la vidéo, ses coins arrondis et son ombre, et une caméra détourée reposent sur de la transparence, prêtes à être posées sur n’importe quoi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景を省きます：ビデオとその角丸・シャドウ、切り抜いたカメラが透明の上に置かれ、何の上にも重ねられます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без фона: видео с его скруглёнными углами и тенью и вырезанная камера лежат на прозрачности — их можно наложить на что угодно"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без тла: відео з його заокругленими кутами й тінню та вирізана камера лежать на прозорості — їх можна накласти на будь-що"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去掉背景：视频及其圆角和阴影，以及抠出的摄像头画面都位于透明层上，可叠放在任何内容之上"
          }
        }
      }
    },
