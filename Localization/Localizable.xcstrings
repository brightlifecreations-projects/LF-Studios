    "Home is where you start something new and find everything you made." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier fängst du etwas Neues an und findest alles, was du gemacht hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accueil, c’est là que vous commencez quelque chose de nouveau et retrouvez tout ce que vous avez créé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームでは、新しい作業を始めたり、これまでに作ったものを探したりできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На главной вы начинаете новую работу и находите все, что уже сделали."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На головній ви починаєте щось нове й знаходите все, що створили."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“主页”中，你可以开始新的创作，也能找到做过的所有内容。"
          }
        }
      }
    },
    "Home ▸ Guide, or Help ▸ LF Studios Guide." : {
      "localizations" : {
