    "Get the area exactly right: a magnifier, the size as you drag, and keys to fine-tune." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triff den Bereich genau: mit Lupe, Größenanzeige beim Ziehen und Tasten zum Feinjustieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez exactement la bonne zone : une loupe, la taille pendant que vous faites glisser et des touches pour l’ajuster."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡大鏡、ドラッグ中のサイズ表示、微調整用のキーで、範囲をぴったり合わせます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделите область точно: лупа, размер во время выделения и клавиши для точной подстройки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть область точно: лупа, розмір під час перетягування й клавіші для точного налаштування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确选择区域：放大镜、拖移时显示的尺寸，以及用于微调的按键。"
          }
        }
      }
    },
    "Get things ready while the countdown runs." : {
      "localizations" : {
