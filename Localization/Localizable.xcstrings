          }
        }
      }
    },
    "The search box finds projects by name, and screenshots by the text in them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Suchfeld findet Projekte nach Namen und Bildschirmfotos nach dem Text darin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ de recherche trouve les projets par leur nom, et les captures par le texte qu’elles contiennent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドでは、プロジェクトを名前で、スクリーンショットを写っているテキストで検索できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поле поиска находит проекты по имени, а снимки — по тексту на них."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
