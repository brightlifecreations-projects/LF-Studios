    "The bubble follows your face, so you stay in the middle even when you move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Blase folgt deinem Gesicht, damit du in der Mitte bleibst, auch wenn du dich bewegst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bulle suit votre visage, pour que vous restiez au centre même quand vous bougez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイプが顔を追いかけるので、動いても中央に映り続けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окошко следует за вашим лицом, и вы остаетесь в центре, даже когда двигаетесь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бульбашка стежить за вашим обличчям, тож ви лишаєтеся в центрі, навіть коли рухаєтеся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "气泡会跟随你的脸，即使你移动，也能保持在画面中央。"
          }
        }
      }
    },
    "The bubble follows your face; where none was found it holds the last framing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Blase folgt deinem Gesicht; wo keins gefunden wurde, hält sie den letzten Ausschnitt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bulle suit votre visage ; là où aucun n’a été trouvé, elle garde le dernier cadrage"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワイプが顔を追いかけます。顔が見つからない部分では最後のフレーミングを保ちます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окошко следует за лицом; где его нет, сохраняется последний кадр"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бульбашка стежить за обличчям; де його немає, лишається останній кадр"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "气泡跟随你的面部；找不到面部的地方保持上一个取景"
          }
        }
      }
    },
    "The bubble now follows your face" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Blase folgt jetzt deinem Gesicht"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
