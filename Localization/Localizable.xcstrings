          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетяните, чтобы переместить. Нажмите Command-C, чтобы скопировать, или Escape, чтобы закрыть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть, щоб перемістити. Натисніть Command-C, щоб скопіювати, або Escape, щоб закрити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以移动。按下 Command-C 拷贝，按下 Esc 键关闭。"
          }
        }
      }
    },
    "Drag to move; drag a corner to resize" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Bewegen ziehen; zum Ändern der Größe an einer Ecke ziehen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour déplacer ; faites glisser un coin pour redimensionner"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで移動、角をドラッグでサイズを変更"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетяните, чтобы переместить; тяните за угол, чтобы изменить размер"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть, щоб перемістити; тягніть кут, щоб змінити розмір"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以移动；拖移角以调整大小"
          }
        }
      }
    },
    "Drag to point the arrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um den Pfeil auszurichten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
