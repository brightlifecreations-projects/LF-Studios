    "In History: the All Captures menu at the top, and the screenshots themselves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Verlauf: das Menü „Alle Bildschirmfotos“ oben und die Bildschirmfotos selbst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’historique : le menu Toutes les captures en haut, et les captures elles-mêmes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴の上部にある“すべてのスクリーンショット”メニューと、スクリーンショット自体。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В истории: меню «Все снимки» вверху и сами снимки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
