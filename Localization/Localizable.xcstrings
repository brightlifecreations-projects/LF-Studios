    "Hide when idle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Stillstand ausblenden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer à l’arrêt"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静止中は非表示"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать при бездействии"
          }
        },
