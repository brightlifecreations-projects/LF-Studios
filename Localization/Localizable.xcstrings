    "Your notes are remembered. A recording made with them open keeps a copy, shown in the editor's Captions panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen werden gespeichert. Eine Aufnahme, bei der sie offen waren, behält eine Kopie, die im Panel „Untertitel“ des Editors erscheint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos notes sont retenues. Un enregistrement fait avec les notes ouvertes en garde une copie, visible dans le panneau Sous-titres de l’éditeur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモは記憶されます。メモを開いたまま収録すると、そのコピーが収録に残り、エディタの“字幕”パネルに表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметки запоминаются. Запись, сделанная с открытыми заметками, сохраняет их копию — она видна на панели «Субтитры» в редакторе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші нотатки запам’ятовуються. Запис, зроблений з відкритими нотатками, зберігає їхню копію — її видно на панелі «Субтитри» в редакторі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的备注会被记住。打开备注时录制的内容会保留一份副本，显示在编辑器的“字幕”面板中。"
          }
        }
      }
    },
    "Your notes from recording, as Notes.txt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
