    "You see the report before anything is sent, and you send it yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst den Bericht, bevor irgendetwas gesendet wird, und du sendest ihn selbst."
          }
        },
        "fr" : {
