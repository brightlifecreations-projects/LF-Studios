        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をマイスタイルにしました — 「マイスタイルを適用」（⇧⌘Y）でビデオに適用できます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — ваш «Мой стиль»; «Применить мой стиль» (⇧⌘Y) применит его к видео"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
