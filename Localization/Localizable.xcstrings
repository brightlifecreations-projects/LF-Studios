    },
    "Makes the bubble smaller during zooms, so it covers less." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht die Blase während Zooms kleiner, damit sie weniger verdeckt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit la bulle pendant les zooms, pour qu’elle cache moins de choses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ズーム中にワイプを小さくして、隠れる部分を減らします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшает окошко во время увеличений, чтобы оно меньше закрывало."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зменшує бульбашку під час наближень, щоб вона менше закривала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在缩放时让气泡变小，减少遮挡。"
          }
        }
      }
    },
