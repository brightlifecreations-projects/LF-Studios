    "Blur and Pixelate: hide passwords, names, and other private details. Strength sets how much." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weichzeichnen und Verpixeln: Verbirg Passwörter, Namen und andere private Details. „Stärke“ legt fest, wie stark."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flou et Pixélisation : cachez mots de passe, noms et autres détails privés. Intensité règle la force de l’effet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼかしとモザイク: パスワード、名前などの個人的な情報を隠します。“強さ”でかかり具合を設定します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размытие и пикселизация: скрывают пароли, имена и другие личные данные. «Сила» задает степень."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розмиття й пікселізація: приховують паролі, імена та інші особисті дані. «Сила» задає ступінь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊和像素化：隐藏密码、姓名和其他隐私细节。“强度”决定遮盖的程度。"
          }
        }
      }
    },
    "Blur any part of the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
