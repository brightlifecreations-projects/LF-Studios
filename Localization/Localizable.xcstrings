    "Links you click, like Report Issue or a link in a QR code, open in your web browser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, auf die du klickst, etwa „Problem melden“ oder ein Link in einem QR-Code, öffnen sich in deinem Webbrowser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens sur lesquels vous cliquez, comme Signaler un problème ou un lien dans un code QR, s’ouvrent dans votre navigateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“問題を報告”やQRコード内のリンクなど、クリックしたリンクはWebブラウザで開きます。"
