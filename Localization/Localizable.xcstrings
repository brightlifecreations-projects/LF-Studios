          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть проєкт правою кнопкою на головній ▸ Видалити: він потрапить у Смітник."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
