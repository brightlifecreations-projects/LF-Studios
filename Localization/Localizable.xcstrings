    "Drag captions to any spot on the video, or move one caption on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh Untertitel an jede Stelle im Video oder verschieb einen einzelnen Untertitel für sich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
