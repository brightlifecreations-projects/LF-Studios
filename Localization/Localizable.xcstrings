    "Show the camera full screen, side by side with the screen, or hide it, for any part of the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig die Kamera im Vollbild, neben dem Bildschirm oder blende sie aus – für jeden Teil des Videos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez la caméra en plein écran, côte à côte avec l’écran, ou masquez-la, pour n’importe quelle partie de la vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの好きな部分で、カメラを全面に表示したり、画面と横並びにしたり、隠したりします。"
