    "Motion blur adds a soft trail when the pointer moves fast." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegungsunschärfe fügt eine weiche Spur hinzu, wenn sich der Zeiger schnell bewegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flou de mouvement ajoute une traînée douce quand le pointeur se déplace vite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“モーションブラー”を使うと、ポインタが速く動いたときに柔らかい残像が付きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Размытие движения» добавляет мягкий след, когда указатель движется быстро."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Розмиття руху» додає м’який слід, коли курсор рухається швидко."
