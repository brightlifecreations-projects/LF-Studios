    },
    "Your screenshots and videos look the same either way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bildschirmfotos und Videos sehen so oder so gleich aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos captures et vidéos sont identiques dans les deux cas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらでも、スクリーンショットやビデオの見た目は変わりません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимки и видео в любом случае выглядят одинаково."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші знімки й відео в будь-якому разі мають однаковий вигляд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论哪种外观，你的截屏和视频看起来都一样。"
          }
        }
      }
    },
    "Your screenshots, recordings, and edits are yours. LF Studios has no account, and sends nothing about you or your work anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bildschirmfotos, Aufnahmen und Bearbeitungen gehören dir. LF Studios hat kein Konto und sendet nichts über dich oder deine Arbeit irgendwohin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos captures, enregistrements et montages vous appartiennent. LF Studios n’a pas de compte, et n’envoie rien sur vous ou votre travail, nulle part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショット、収録、編集したものは、すべて自分のものです。LF Studiosにはアカウントがなく、ユーザや作品についての情報をどこにも送信しません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши снимки, записи и правки принадлежат вам. В LF Studios нет учетной записи, и приложение никуда не отправляет ничего о вас или вашей работе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші знімки, записи й монтаж належать вам. LF Studios не має облікового запису й нікуди не надсилає нічого про вас чи вашу роботу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的截屏、录制内容和编辑都属于你。LF Studios 不需要帐户，也不会把关于你或你作品的任何信息发送到任何地方。"
          }
        }
      }
    },
