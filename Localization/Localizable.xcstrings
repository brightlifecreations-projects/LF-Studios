    "Follows where you typed. Pressing it again replaces only these zooms." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt der Stelle, an der du getippt hast. Erneut gedrückt, ersetzt es nur diese Zooms."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit l’endroit où vous avez tapé. Appuyer de nouveau ne remplace que ces zooms."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力した場所に追従します。もう一度押すと、これらのズームだけが置き換わります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следует за местом, где вы печатали. Повторное нажатие заменяет только эти увеличения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стежить за місцем, де ви друкували. Повторне натискання замінює лише ці наближення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随你打字的位置。再次按下只会替换这些缩放。"
          }
        }
      }
    },
