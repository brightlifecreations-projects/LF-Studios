    "Deleted captures waiting in History's trash and files no capture uses are removed for good, along with %lld captures past your History limit. The rest of your history stays." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Gelöschte Bildschirmfotos im Papierkorb des Verlaufs und Dateien, die kein Bildschirmfoto verwendet, werden endgültig entfernt – ebenso %lld Bildschirmfoto, das die Grenze deines Verlaufs überschreitet. Der Rest deines Verlaufs bleibt erhalten."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Gelöschte Bildschirmfotos im Papierkorb des Verlaufs und Dateien, die kein Bildschirmfoto verwendet, werden endgültig entfernt – ebenso %lld Bildschirmfotos, die die Grenze deines Verlaufs überschreiten. Der Rest deines Verlaufs bleibt erhalten."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Deleted captures waiting in History's trash and files no capture uses are removed for good, along with %lld capture past your History limit. The rest of your history stays."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Deleted captures waiting in History's trash and files no capture uses are removed for good, along with %lld captures past your History limit. The rest of your history stays."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les captures supprimées en attente dans la corbeille de l’historique et les fichiers qu’aucune capture n’utilise sont définitivement supprimés, ainsi que %lld capture au-delà de la limite de votre historique. Le reste de votre historique est conservé."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les captures supprimées en attente dans la corbeille de l’historique et les fichiers qu’aucune capture n’utilise sont définitivement supprimés, ainsi que %lld captures au-delà de la limite de votre historique. Le reste de votre historique est conservé."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴のゴミ箱にある削除済みのスクリーンショットと、どのスクリーンショットにも使われていないファイルが、履歴の上限を超えた%lld件のスクリーンショットとともに完全に削除されます。そのほかの履歴は残ります。"
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Снимки из корзины истории и файлы, которые не использует ни один снимок, будут удалены безвозвратно, как и %lld снимка сверх лимита истории. Остальная история сохранится."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Снимки из корзины истории и файлы, которые не использует ни один снимок, будут удалены безвозвратно, как и %lld снимков сверх лимита истории. Остальная история сохранится."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Снимки из корзины истории и файлы, которые не использует ни один снимок, будут удалены безвозвратно, как и %lld снимок сверх лимита истории. Остальная история сохранится."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Снимки из корзины истории и файлы, которые не использует ни один снимок, будут удалены безвозвратно, как и %lld снимка сверх лимита истории. Остальная история сохранится."
                }
              }
            }
          }
        },
        "uk" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Видалені знімки з кошика історії та файли, яких не використовує жоден знімок, буде вилучено назавжди, а разом із ними — %lld знімки понад обмеження історії. Решта історії залишиться."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Видалені знімки з кошика історії та файли, яких не використовує жоден знімок, буде вилучено назавжди, а разом із ними — %lld знімків понад обмеження історії. Решта історії залишиться."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Видалені знімки з кошика історії та файли, яких не використовує жоден знімок, буде вилучено назавжди, а разом із ними — %lld знімок понад обмеження історії. Решта історії залишиться."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Видалені знімки з кошика історії та файли, яких не використовує жоден знімок, буде вилучено назавжди, а разом із ними — %lld знімка понад обмеження історії. Решта історії залишиться."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录废纸篓中已删除的截屏、不再被任何截屏使用的文件，以及超出历史记录保留限制的 %lld 张截屏将被永久移除。其余历史记录会保留。"
          }
        }
      }
    },
    "Deleted captures waiting in History's trash and files no capture uses are removed for good. The captures in your history stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Bildschirmfotos im Papierkorb des Verlaufs und Dateien, die kein Bildschirmfoto verwendet, werden endgültig entfernt. Die Bildschirmfotos in deinem Verlauf bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures supprimées en attente dans la corbeille de l’historique et les fichiers qu’aucune capture n’utilise sont définitivement supprimés. Les captures de votre historique sont conservées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴のゴミ箱にある削除済みのスクリーンショットと、どのスクリーンショットにも使われていないファイルが完全に削除されます。履歴内のスクリーンショットは残ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимки из корзины истории и файлы, которые не использует ни один снимок, будут удалены безвозвратно. Снимки в истории сохранятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалені знімки з кошика історії та файли, яких не використовує жоден знімок, буде вилучено назавжди. Знімки в історії залишаться."
          }
        },
        "zh-Hans" : {
