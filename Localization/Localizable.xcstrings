    "Check that the recording has sound, and that the Language matches what you speak." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüf, ob die Aufnahme Ton hat und die Sprache zu dem passt, was du sprichst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que l’enregistrement a du son, et que la Langue correspond à celle que vous parlez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録に音声が入っていること、“言語”が話している言語と合っていることを確認します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте, что в записи есть звук и что «Язык» совпадает с языком, на котором вы говорите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте, що в записі є звук і що вибрана «Мова» збігається з тією, якою ви говорите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认录制内容有声音，并且“语言”与你说的语言一致。"
          }
        }
      }
    },
    "Check that your Mac is online." : {
