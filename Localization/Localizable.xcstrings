    "Give another editor, or an app like Final Cut Pro, every part of your video as separate files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einem anderen Editor oder einer App wie Final Cut Pro jeden Teil deines Videos als eigene Datei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à un autre monteur, ou à une app comme Final Cut Pro, chaque élément de votre vidéo en fichiers séparés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
