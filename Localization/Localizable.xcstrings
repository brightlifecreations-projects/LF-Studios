    "Flags on the timeline for important moments. They can split the video and become chapters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahnen auf der Zeitleiste für wichtige Momente. Sie können das Video teilen und zu Kapiteln werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des drapeaux sur la timeline pour les moments importants. Ils peuvent scinder la vidéo et devenir des chapitres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大事な場面を示すタイムライン上の旗です。ビデオを分割したり、チャプターにしたりできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флажки на шкале времени для важных моментов. По ним можно разделить видео и сделать главы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прапорці на шкалі часу для важливих моментів. Вони можуть ділити відео на частини й ставати розділами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
