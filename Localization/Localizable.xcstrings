    },
    "Your recordings are never uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahmen werden nie hochgeladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos enregistrements ne sont jamais envoyés en ligne."
          }
        },
