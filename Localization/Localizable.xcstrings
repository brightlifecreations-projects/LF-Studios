            "state" : "translated",
            "value" : "Шрифти"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字体"
          }
        }
      }
    },
    "For Custom image…, choose a PNG, then click the spot in it that points." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für „Eigenes Bild …“ wählst du ein PNG und klickst dann auf die Stelle darin, die zeigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour Image personnalisée…, choisissez un PNG, puis cliquez sur le point de l’image qui sert de pointe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“カスタム画像…”では、PNGを選んでから、画像の中で指し示す点をクリックします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для «Своё изображение…» выберите PNG, затем нажмите на точку картинки, которая будет острием."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для «Власне зображення…» виберіть PNG, а тоді клацніть на ньому точку, яка вказує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果选择“自定图像…”，请选择一张 PNG 图片，然后点按图片中指针尖所在的位置。"
          }
        }
      }
    },
    "For Final Cut Pro, DaVinci Resolve, and Adobe Premiere Pro" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Final Cut Pro, DaVinci Resolve und Adobe Premiere Pro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour Final Cut Pro, DaVinci Resolve et Adobe Premiere Pro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Final Cut Pro、DaVinci Resolve、Adobe Premiere Pro用"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для Final Cut Pro, DaVinci Resolve и Adobe Premiere Pro"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для Final Cut Pro, DaVinci Resolve і Adobe Premiere Pro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于 Final Cut Pro、DaVinci Resolve 和 Adobe Premiere Pro"
          }
        }
      }
    },
    "For Selection, ⇧-drag on the timeline first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für „Auswahl“ zieh vorher mit ⇧ auf der Zeitleiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour Sélection, sélectionnez d’abord un passage sur la timeline en faisant glisser avec ⇧."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“選択範囲”の場合は、先にタイムライン上で⇧キーを押しながらドラッグします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для «Выделение» сначала проведите с ⇧ по шкале времени."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для «Вибір» спершу виділіть частину на шкалі часу, перетягнувши з ⇧."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用“选区”，请先在时间线上按住 ⇧ 拖移。"
          }
        }
      }
    },
    "For a GIF: choose GIF, then a Size and a Frame rate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für ein GIF: Wähle GIF, dann eine Größe und eine Bildrate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un GIF : choisissez GIF, puis une Taille et une Fréquence d’images."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIFの場合: “GIF”を選び、“サイズ”と“フレームレート”を選びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для GIF: выберите GIF, затем размер и частоту кадров."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для GIF: виберіть GIF, а тоді «Розмір» і «Частота кадрів»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出 GIF：选择 GIF，然后选择“大小”和“帧速率”。"
          }
        }
      }
    },
    "For a click sound too, see Click sounds in the Audio panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch ein Klickgeräusch? Siehe „Klickgeräusche“ im Panel „Audio“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un son de clic en plus, voyez Sons de clic dans le panneau Audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリック音も付けたい場合は、“オーディオ”パネルの“クリック音”を参照してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы нажатия еще и звучали, смотрите «Звуки нажатий» на панели «Аудио»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб додати ще й звук клацання, див. «Звуки клацання» на панелі «Аудіо»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果还想要点按声，请参阅“音频”面板中的“点按音效”。"
          }
        }
      }
    },
    "For a faster, smaller file, choose 1080p, 30 fps, and MP4." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine schnellere, kleinere Datei wähle 1080p, 30 fps und MP4."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un fichier plus rapide et plus léger, choisissez 1080p, 30 fps et MP4."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より速く小さいファイルにするには、1080p、30fps、MP4を選びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы файл получился быстрее и меньше, выберите 1080p, 30 fps и MP4."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб файл був швидшим і меншим, виберіть 1080p, 30 fps і MP4."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要获得更快、更小的文件，请选择 1080p、30 fps 和 MP4。"
          }
        }
      }
    },
    "For a narrow video from a wide recording: the picture fills the frame and follows your pointer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für ein schmales Video aus einer breiten Aufnahme: Das Bild füllt den Rahmen und folgt deinem Zeiger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une vidéo étroite tirée d’un enregistrement large : l’image remplit le cadre et suit votre pointeur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横長の収録から縦長のビデオを作る場合: 映像が画面いっぱいに表示され、ポインタを追いかけます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для узкого видео из широкой записи: картинка заполняет кадр и следует за указателем."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для вузького відео із широкого запису: зображення заповнює кадр і стежить за курсором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用宽屏录制内容制作窄画面视频时：画面会填满整个画框，并跟随你的指针。"
          }
        }
      }
    },
    "For a vertical video, Fill the Frame, Follow the Cursor in the aspect ratio menu does the same for the whole video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Hochformat-Video macht „Bild füllen und dem Zeiger folgen“ im Menü für das Seitenverhältnis dasselbe für das ganze Video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une vidéo verticale, Remplir le cadre et suivre le pointeur, dans le menu du format d’image, fait la même chose pour toute la vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縦型ビデオでは、アスペクト比メニューの“画面いっぱいに表示してポインタに追従”で、ビデオ全体に同じことができます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для вертикального видео пункт «Заполнить кадр и следовать за указателем» в меню соотношения сторон делает то же самое для всего видео."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для вертикального відео «Заповнити кадр і стежити за курсором» у меню формату робить те саме для всього відео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于竖屏视频，宽高比菜单中的“填满画面并跟随指针”可以对整个视频做同样的事。"
          }
        }
      }
    },
    "For a zoom on every click, turn on Auto-zoom on clicks in the Zoom panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Zoom bei jedem Klick schalte im Panel „Zoom“ die Option „Auto-Zoom bei Klicks“ ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un zoom à chaque clic, activez Zoom auto sur les clics dans le panneau Zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックするたびにズームするには、“ズーム”パネルで“クリックで自動ズーム”をオンにします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы увеличение добавлялось при каждом нажатии, включите «Автомасштаб по нажатиям» на панели «Масштаб»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб наближення з’являлося після кожного клацання, увімкніть «Автонаближення за клацаннями» на панелі «Масштаб»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在每次点按时都缩放，请在“缩放”面板中打开“点按时自动缩放”。"
          }
        }
      }
    },
    "For captions with the Whisper engine. Models are downloaded from Hugging Face only when you choose one; transcribing happens on this Mac and nothing is uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Untertitel mit Whisper. Modelle werden nur von Hugging Face geladen, wenn du eines auswählst; die Transkription läuft auf diesem Mac, und nichts wird hochgeladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les sous-titres avec Whisper. Les modèles sont téléchargés depuis Hugging Face uniquement quand vous en choisissez un ; la transcription se fait sur ce Mac et rien n’est envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisperエンジンによる字幕用。モデルは選んだときにだけHugging Faceからダウンロードされます。文字起こしはこのMac上で行われ、何もアップロードされません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для субтитров с движком Whisper. Модели загружаются с Hugging Face, только когда вы их выбираете; расшифровка идёт на этом Mac, ничего не отправляется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для субтитрів із рушієм Whisper. Моделі завантажуються з Hugging Face, лише коли ви їх обираєте; розшифрування відбувається на цьому Mac, нічого не надсилається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于 Whisper 引擎生成字幕。只有在你选择模型时才会从 Hugging Face 下载；转写在此 Mac 上进行，不会上传任何内容。"
          }
        }
      }
    },
    "For private information, use a high Strength: a light blur can sometimes still be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm für private Informationen eine hohe Stärke: Ein leichter Weichzeichner ist manchmal noch lesbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour des informations privées, utilisez une Intensité élevée : un flou léger peut parfois encore se lire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人情報には、“強さ”を高く設定してください。弱いぼかしでは読み取れてしまうことがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для личных данных ставьте высокую силу: слабое размытие иногда все еще можно прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для особистих даних ставте високу «Силу»: слабке розмиття іноді вдається прочитати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遮盖隐私信息时，请使用较高的“强度”：轻度模糊有时仍能被看清。"
          }
        }
      }
    },
    "For sound only: choose Audio only at the top, then M4A, WAV, or AIFF." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für den Ton: Wähle oben „Nur Ton“, dann M4A, WAV oder AIFF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour le son seul : choisissez Audio seul en haut, puis M4A, WAV ou AIFF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声のみの場合: 上部で“オーディオのみ”を選び、M4A、WAV、AIFFのいずれかを選びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только звук: выберите «Только звук» вверху, затем M4A, WAV или AIFF."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише для звуку: виберіть «Лише звук» угорі, а тоді M4A, WAV чи AIFF."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只导出声音：在顶部选择“仅音频”，然后选择 M4A、WAV 或 AIFF。"
          }
        }
      }
    },
    "For the camera only; the screen stays as recorded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für die Kamera; der Bildschirm bleibt wie aufgenommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour la caméra uniquement ; l’écran reste tel qu’enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラだけに適用され、画面は収録したままです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только для камеры; экран остаётся как записан."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише для камери; екран лишається як записаний."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅作用于摄像头；屏幕保持录制时的样子。"
          }
        }
      }
    },
    "For things behind you, like a whiteboard or a document" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Dinge hinter dir, etwa ein Whiteboard oder ein Dokument"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
