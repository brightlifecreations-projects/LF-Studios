    "Voice and Computer sound each have their own slider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimme und Systemton haben jeweils einen eigenen Regler."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voix et Son de l’ordinateur ont chacun leur curseur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“声”と“システムオーディオ”には、それぞれ専用のスライダがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «Голос» и «Звук компьютера» свои ползунки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Голос» і «Звук комп’ютера» мають власні повзунки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“人声”和“电脑声音”各有自己的滑块。"
          }
        }
      }
    },
    "Voice enhanced — background noise removed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimme verbessert – Hintergrundgeräusche entfernt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voix améliorée — bruit de fond supprimé"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声を補正し、背景ノイズを除去しました"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос улучшен — фоновый шум удален"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голос покращено — фоновий шум вилучено"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人声已增强 — 背景噪音已移除"
          }
        }
      }
    },
    "Voice enhancement isn't available on this Mac. Turn off Enhance voice to keep the original sound." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stimmverbesserung ist auf diesem Mac nicht verfügbar. Deaktiviere „Stimme verbessern“, um den Originalton zu behalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amélioration de la voix n’est pas disponible sur ce Mac. Désactivez Améliorer la voix pour garder le son d’origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは声の補正を使用できません。元のサウンドのままにするには、“声を補正”をオフにしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшение голоса недоступно на этом Mac. Выключите «Улучшение голоса», чтобы сохранить исходный звук."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покращення голосу недоступне на цьому Mac. Вимкніть «Покращити голос», щоб зберегти оригінальний звук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 不支持人声增强。请关闭“增强人声”以保留原始声音。"
          }
        }
      }
    },
    "Voice enhancement stopped partway. Turn Enhance voice off and on again to retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stimmverbesserung wurde unterbrochen. Schalte „Stimme verbessern“ aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amélioration de la voix s’est interrompue. Désactivez puis réactivez Améliorer la voix pour réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声の補正が途中で停止しました。もう一度試すには、“声を補正”をオフにしてから再度オンにしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшение голоса прервалось. Выключите и снова включите «Улучшение голоса», чтобы повторить попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покращення голосу зупинилося на півдорозі. Вимкніть і знову ввімкніть «Покращити голос», щоб повторити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人声增强中途停止。请关闭再打开“增强人声”以重试。"
          }
        }
      }
    },
