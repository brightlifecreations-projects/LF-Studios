    "The whole mix at −16 LUFS, peaks under −1 dB" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ganze Mischung bei −16 LUFS, Spitzen unter −1 dB"
