    "Every capture, recording, and tool, from the LF Studios icon in the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Aufnahme, jede Aufzeichnung und jedes Werkzeug, über das LF-Studios-Symbol in der Menüleiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les captures, tous les enregistrements et tous les outils, depuis l’icône LF Studios dans la barre des menus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーのLF Studiosアイコンから、すべての取り込み、収録、ツールを使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
