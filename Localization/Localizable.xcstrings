    "A teleprompter for your script. It never shows up in a recording, a screenshot, or screen sharing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teleprompter für dein Skript. Er erscheint nie in einer Aufnahme, einem Bildschirmfoto oder bei der Bildschirmfreigabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un prompteur pour votre texte. Il n’apparaît jamais dans un enregistrement, une capture ou un partage d’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台本用のプロンプターです。収録、スクリーンショット、画面共有に映ることはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суфлер для вашего текста. Никогда не попадает в запись, на снимок экрана или в демонстрацию экрана."
          }
        },
        "uk" : {
          "stringUnit" : {
