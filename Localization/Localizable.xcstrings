    "Between clips: Hard cut, Dissolve, or Dip to black, with a Length." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen Clips: Schnitt, Überblenden oder Schwarzblende, mit einer Dauer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre les clips : Coupe, Fondu ou Fondu au noir, avec une Durée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップの間: “カット”、“ディゾルブ”、“黒にフェード”から選び、“長さ”を設定します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Между клипами: «Жесткая склейка», «Растворение» или «Затемнение», с настройкой «Длительность»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Між кліпами: «Пряма склейка», «Розчинення» чи «Затемнення» з потрібною «Тривалістю»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
