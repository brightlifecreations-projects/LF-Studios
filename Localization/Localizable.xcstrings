    "Only %@ free on your disk — this may not fit. Free up space or save to another drive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur noch %@ frei auf deiner Festplatte – das reicht eventuell nicht. Gib Speicherplatz frei oder sichere auf einem anderen Laufwerk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement %@ libres sur votre disque — cela risque de ne pas suffire. Libérez de l’espace ou enregistrez sur un autre disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクの空き容量が%@しかないため、収まらない可能性があります。空き容量を増やすか、別のドライブに保存してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На диске свободно только %@ — этого может не хватить. Освободите место или сохраните на другой диск."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На диску вільно лише %@ — цього може не вистачити. Звільніть місце або збережіть на інший диск."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的磁盘上仅剩 %@ 可用空间 — 可能放不下。请释放空间或存储到其他磁盘。"
          }
        }
      }
    },
