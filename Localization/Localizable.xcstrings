    "Help for every part of LF Studios, with search, steps, and a Show me button that takes you there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfe zu jedem Teil von LF Studios, mit Suche, Schritten und einem Knopf „Zeig’s mir“, der dich direkt hinführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l’aide pour chaque partie de LF Studios, avec une recherche, des étapes et un bouton Me montrer qui vous y emmène."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosのすべての機能についてのヘルプです。検索、手順、そして場所を開く“見てみる”ボタンがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справка по всем частям LF Studios: поиск, пошаговые инструкции и кнопка «Показать», которая ведет в нужное место."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Довідка про кожну частину LF Studios — з пошуком, кроками й кнопкою «Показати», яка веде в потрібне місце."
          }
        },
        "zh-Hans" : {
