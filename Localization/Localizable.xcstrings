          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suppression du bruit, De-esser (adoucit les sons « s »), Égaliseur chaud et clair, Compression et Volume podcast : chacun avec son interrupteur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ノイズ除去”、“ディエッサー”（“さ行”の耳障りな音を和らげます）、“温かくクリアなEQ”、“コンプレッサー”、“ポッドキャストのラウドネス”: それぞれ専用のスイッチがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
