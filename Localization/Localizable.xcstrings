    "History ▸ Clear All deletes every screenshot (it can be undone for 7 days)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf ▸ Alle löschen löscht alle Bildschirmfotos (7 Tage lang lässt sich das widerrufen)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique ▸ Tout effacer supprime toutes les captures (annulable pendant 7 jours)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“履歴”＞“すべてを消去”では、すべてのスクリーンショットを削除します（7日間は取り消せます）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История ▸ Удалить все удаляет все снимки (это можно отменить в течение 7 дней)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія ▸ Очистити все видаляє всі знімки (протягом 7 днів це можна відмінити)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“历史记录 ▸ 全部清除”会删除所有截屏（7 天内可以撤销）。"
          }
        }
      }
    },
    "History ▸ right-click a screenshot ▸ Pin to Screen, or Pin on the preview after capture." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf ▸ Rechtsklick auf ein Bildschirmfoto ▸ Auf dem Bildschirm anheften, oder „Anheften“ in der Vorschau nach der Aufnahme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique ▸ clic droit sur une capture ▸ Épingler à l’écran, ou Épingler sur l’aperçu après la capture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“履歴”＞スクリーンショットを右クリック＞“画面に固定”、または取り込み後のプレビューの“画面に固定”。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История ▸ правой кнопкой мыши на снимке ▸ Закрепить на экране или «Закрепить» в превью после снимка."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія ▸ клацніть знімок правою кнопкою ▸ Закріпити на екрані, або «Закріпити» на перегляді після знімка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录 ▸ 右键点按截屏 ▸ 贴到屏幕，或点按截取后预览中的“贴到屏幕”。"
          }
        }
      }
    },
    "Hold Space while dragging to move the area instead of resizing it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte beim Ziehen die Leertaste gedrückt, um den Bereich zu verschieben, statt seine Größe zu ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
