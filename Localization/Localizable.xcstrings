    "Double-click text on the preview to change it. New ones keep the last color and size you used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke in der Vorschau auf einen Text, um ihn zu ändern. Neue übernehmen die zuletzt verwendete Farbe und Größe."
          }
        },
        "fr" : {
          "stringUnit" : {
