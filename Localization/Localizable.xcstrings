    "Before recording, turn on Microphone in the recording bar and check that its level meter moves when you speak." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte vor der Aufzeichnung in der Aufzeichnungsleiste „Mikrofon“ ein und prüf, ob sich die Pegelanzeige bewegt, wenn du sprichst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant d’enregistrer, activez Micro dans la barre d’enregistrement et vérifiez que son indicateur de niveau bouge quand vous parlez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録する前に、収録バーで“マイク”をオンにし、話したときにレベルメーターが動くことを確認します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед записью включите «Микрофон» на панели записи и проверьте, что индикатор уровня движется, когда вы говорите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед записом увімкніть «Мікрофон» на панелі запису й перевірте, що індикатор рівня рухається, коли ви говорите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制前，在录制栏中打开“麦克风”，并确认说话时它的电平表会跳动。"
          }
        }
      }
    },
    "Before recording, turn on Track where I type." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte vor der Aufzeichnung „Verfolgen, wo ich tippe“ ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant l’enregistrement, activez Suivre où je tape."
