          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть под видео играет музыка. Она повторяется, плавно нарастает и затухает и становится тише, пока вы говорите."
          }
        },
        "uk" : {
          "stringUnit" : {
