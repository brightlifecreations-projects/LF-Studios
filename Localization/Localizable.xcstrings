            "value" : "Exportiert mit der Lautheit, die Videoplattformen erwarten, ohne Verzerrung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte au volume attendu par les sites vidéo, sans distorsion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画サイトが求める音量で、音割れせずに書き出します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт с громкостью, которую ожидают видеосайты, без искажений."
          }
