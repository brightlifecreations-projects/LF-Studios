    "Settings ▸ Screenshots ▸ Window Capture adds a soft shadow and some transparent space around the window. It's on to start with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen ▸ Bildschirmfotos ▸ Fensteraufnahme fügt einen weichen Schatten und etwas transparenten Rand um das Fenster hinzu. Das ist anfangs eingeschaltet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages ▸ Captures ▸ Capture de fenêtre ajoute une ombre douce et un peu d’espace transparent autour de la fenêtre. C’est activé au départ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“設定”＞“スクリーンショット”＞“ウインドウの取り込み”では、ウインドウの周りに柔らかいシャドウと透明な余白が付きます。最初はオンになっています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки ▸ Снимки экрана ▸ Снимки окон добавляет вокруг окна мягкую тень и немного прозрачного места. Сразу включено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметри ▸ Знімки екрана ▸ Знімок вікна додає м’яку тінь і трохи прозорого простору довкола вікна. Спершу це ввімкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“设置 ▸ 截屏 ▸ 窗口截屏”会在窗口周围添加柔和的阴影和一些透明空白。此选项一开始就是打开的。"
          }
        }
      }
    },
