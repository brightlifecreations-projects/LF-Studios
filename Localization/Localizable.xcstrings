    "Edit your video like a document: delete words, and that part of the video goes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite dein Video wie ein Dokument: Lösch Wörter, und dieser Teil des Videos verschwindet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montez votre vidéo comme un document : supprimez des mots, et ce passage de la vidéo disparaît."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオを書類のように編集します。言葉を削除すると、ビデオのその部分もなくなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монтируйте видео как документ: удаляете слова — и эта часть видео исчезает."
          }
        },
        "uk" : {
