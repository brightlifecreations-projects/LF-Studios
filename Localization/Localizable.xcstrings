      }
    },
    "macOS downloads %@ once, then translates right here — nothing is uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lädt %@ einmalig und übersetzt dann direkt hier – nichts wird hochgeladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS télécharge la langue %@ une seule fois, puis traduit directement ici — rien n’est envoyé en ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが%@を一度ダウンロードすると、以降はこのMac上で翻訳します。何もアップロードされません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS один раз скачает язык «%@», а затем будет переводить прямо здесь — ничего не отправляется в сеть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS один раз завантажить мову «%@», а потім перекладатиме просто тут — нічого не вивантажується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会下载一次%@，之后直接在此翻译 — 不会上传任何内容。"
          }
        }
      }
    },
    "macOS has its own screenshot shortcuts with the same keys." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat eigene Kurzbefehle für Bildschirmfotos mit denselben Tasten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a ses propres raccourcis de capture avec les mêmes touches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSには、同じキーを使う独自のスクリーンショット用ショートカットがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У macOS есть свои сочетания для снимков экрана с теми же клавишами."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У macOS є власні скорочення для знімків екрана з тими самими клавішами."
          }
        },
