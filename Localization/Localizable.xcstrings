    },
    "Looks through your video for faces, email addresses, phone and card numbers, passwords, and words you choose, so you can blur them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht dein Video nach Gesichtern, E-Mail-Adressen, Telefon- und Kartennummern, Passwörtern und Wörtern deiner Wahl, damit du sie weichzeichnen kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourt votre vidéo à la recherche de visages, d’adresses e-mail, de numéros de téléphone et de carte, de mots de passe et des mots de votre choix, pour que vous puissiez les flouter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ内の顔、メールアドレス、電話番号やカード番号、パスワード、指定した言葉を探し、ぼかせるようにします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищет в видео лица, адреса электронной почты, номера телефонов и карт, пароли и выбранные вами слова, чтобы их можно было размыть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукає у відео обличчя, адреси ел. пошти, номери телефонів і карток, паролі та вибрані вами слова, щоб ви могли їх розмити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在视频中查找人脸、电子邮件地址、电话号码和银行卡号、密码以及你指定的字词，以便将它们模糊处理。"
          }
        }
      }
    },
    "Looks: Natural, Warm, Bright, or Cinematic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks: Natürlich, Warm, Hell oder Kinolook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
