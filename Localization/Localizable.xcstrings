    "Capture Text" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text erfassen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturer du texte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを取り込む"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознать текст"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розпізнати текст"
          }
        },
        "zh-Hans" : {
