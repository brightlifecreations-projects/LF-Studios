    },
    "Use Size for line thickness, and Text size and Bold for text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Größe“ stellst du die Linienstärke ein, mit „Textgröße“ und „Fett“ den Text."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Taille pour l’épaisseur des traits, et Taille du texte et Gras pour le texte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線の太さは“サイズ”で、テキストは“テキストサイズ”と“太い”で設定します。"
