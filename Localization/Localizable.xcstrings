    "Move the Camera Instead: slides the bubble to a free corner during that zoom." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stattdessen Kamera verschieben: schiebt die Blase während dieses Zooms in eine freie Ecke."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer plutôt la caméra : fait glisser la bulle vers un coin libre pendant ce zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“代わりにカメラを移動”: そのズームの間、ワイプを空いている隅に移動します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сдвинуть камеру»: на время этого увеличения переносит окошко в свободный угол."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Зсунути камеру»: на час наближення пересуває бульбашку у вільний кут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改为移动摄像头：在该缩放期间把气泡移到空着的角落。"
          }
        }
      }
    },
    "Move the area while dragging" : {
