      }
    },
    "LF Studios doesn't have Screen Recording permission yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios hat noch keine Berechtigung für die Bildschirmaufnahme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios n’a pas encore l’autorisation d’enregistrer l’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosにまだ画面収録のアクセス許可がありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У LF Studios еще нет разрешения на запись экрана."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ще не має дозволу на запис екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 还没有获得屏幕录制权限。"
          }
        }
      }
    },
    "LF Studios finds your outline on this Mac. Choose the Cutout shape to show just you, floating over the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios findet deinen Umriss auf diesem Mac. Wähle die Form „Freigestellt“, um nur dich zu zeigen, schwebend über dem Video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios détecte votre silhouette sur ce Mac. Choisissez la forme Détouré pour n’afficher que vous, flottant par-dessus la vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは、Mac上で人物の輪郭を見つけます。“切り抜き”の形を選ぶと、ビデオの上に自分だけが浮かんで表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios находит ваш силуэт на этом Mac. Выберите форму «Силуэт», чтобы показать только вас поверх видео."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios знаходить ваш силует на цьому Mac. Виберіть форму «Силует», щоб показати лише вас поверх відео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会在这台 Mac 上识别出你的轮廓。选择“抠像”形状，就能只显示你自己，浮在视频上方。"
          }
        }
      }
    },
    "LF Studios is ready to use!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ist startklar!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios est prêt à l’emploi !"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosを使う準備ができました!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios готов к работе!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе готово до роботи з LF Studios!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 已准备就绪！"
          }
        }
      }
    },
    "LF Studios is still cleaning up the voice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios bereinigt noch die Stimme"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios est encore en train de nettoyer la voix"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosはまだ声を補正しています"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios еще очищает голос"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ще очищає голос"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 仍在清理人声"
          }
        }
      }
    },
    "LF Studios is still transcribing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios transkribiert noch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios est encore en train de transcrire"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosはまだ文字起こしをしています"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios еще расшифровывает речь"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ще розшифровує мовлення"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 仍在转录"
          }
        }
      }
    },
    "LF Studios isn't allowed to record the screen. Turn it on in System Settings → Privacy & Security → Screen & System Audio Recording." : {
      "comment" : "Names the System Settings pane as macOS 15 and later call it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios darf den Bildschirm nicht aufzeichnen. Aktiviere es unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Aufnahme von Bildschirm & Systemaudio“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios n’est pas autorisé à enregistrer l’écran. Activez-le dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et des sons du système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosに画面収録が許可されていません。“システム設定”＞“プライバシーとセキュリティ”＞“画面収録とシステムオーディオ録音”でオンにしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не разрешено записывать экран. Включите разрешение в разделе Системные настройки → Конфиденциальность и безопасность → Запись экрана и системного звука."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios не має дозволу на запис екрана. Увімкніть його тут: Системні параметри → Приватність і безпека → Записування системного звуку й екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 无权录制屏幕。请在“系统设置”→“隐私与安全性”→“录屏与系统录音”中开启。"
          }
        }
      }
    },
    "LF Studios keeps your recording safe when things change in the middle of it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios schützt deine Aufnahme, wenn sich mittendrin etwas ändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios protège votre enregistrement quand quelque chose change en cours de route."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録の途中で状況が変わっても、LF Studiosは収録を守ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios бережет вашу запись, когда что-то меняется посреди нее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios береже ваш запис, коли щось змінюється посеред нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制中途情况有变时，LF Studios 会保护好你的录制内容。"
          }
        }
      }
    },
    "LF Studios lines it up with your recording by its sound." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios richtet es anhand des Tons an deiner Aufnahme aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios la cale sur votre enregistrement grâce au son."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosが音声を手がかりに、収録とタイミングを合わせます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios совместит его с записью по звуку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios вирівнює його з вашим записом за звуком."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会根据声音把它与你的录制内容对齐。"
          }
        }
      }
    },
    "LF Studios listens to the recording right on this Mac — nothing is uploaded. Then cut the video by deleting words, remove ums and long pauses in one click, and add captions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios hört sich die Aufnahme direkt auf diesem Mac an – nichts wird hochgeladen. Danach schneidest du das Video, indem du Wörter löschst, entfernst Füllwörter und lange Pausen mit einem Klick und fügst Untertitel hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios écoute l’enregistrement directement sur ce Mac — rien n’est envoyé. Coupez ensuite la vidéo en supprimant des mots, retirez les hésitations et les longues pauses en un clic, et ajoutez des sous-titres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF StudiosはこのMac上で収録を聞き取ります。何もアップロードされません。そのあと、単語を削除してビデオをカットしたり、フィラーや長い無音をワンクリックで削除したり、字幕を追加したりできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios слушает запись прямо на этом Mac — ничего не отправляется в сеть. Затем можно монтировать видео, удаляя слова, одним нажатием убрать слова-паразиты и долгие паузы и добавить субтитры."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios слухає запис просто на цьому Mac — нічого не вивантажується. Потім монтуйте відео, видаляючи слова, одним клацанням вилучайте слова-паразити й довгі паузи та додавайте субтитри."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 直接在这台 Mac 上听取录制内容 — 不会上传任何内容。然后你可以通过删除字词来剪辑视频，一键移除语气词和长停顿，并添加字幕。"
          }
        }
      }
    },
    "LF Studios listens to your recording and writes down what you say, on your Mac. That gives you captions, and lets you edit the video by its words." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios hört sich deine Aufnahme an und schreibt auf, was du sagst – auf deinem Mac. So bekommst du Untertitel und kannst das Video über seine Wörter bearbeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios écoute votre enregistrement et écrit ce que vous dites, sur votre Mac. Vous obtenez ainsi des sous-titres, et pouvez monter la vidéo à partir de ses mots."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosが収録を聞き取り、話した内容をMac上で書き起こします。字幕を作れるほか、言葉を使ってビデオを編集できるようになります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios прослушивает запись и записывает все, что вы говорите, — на вашем Mac. Так получаются субтитры, а видео можно монтировать по словам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios слухає ваш запис і записує те, що ви кажете, — на вашому Mac. Так ви отримуєте субтитри й можете монтувати відео за словами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会在你的 Mac 上聆听录制内容，并写下你说的话。这样就能生成字幕，还能按文字来编辑视频。"
          }
        }
      }
    },
    "LF Studios lives here — setup continues next launch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier findest du LF Studios – die Einrichtung geht beim nächsten Start weiter"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios se trouve ici — la configuration reprendra au prochain lancement"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosはここにあります。設定は次回の起動時に再開します"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios находится здесь — настройка продолжится при следующем запуске"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios тут — налаштування продовжиться під час наступного запуску"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 就在这里 — 下次启动时将继续设置"
          }
        }
      }
    },
    "LF Studios lives in the Dock and in the menu bar. Closing this window keeps it running, so your shortcuts keep working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios findest du im Dock und in der Menüleiste. Wenn du dieses Fenster schließt, läuft es weiter – deine Kurzbefehle funktionieren also weiterhin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios se trouve dans le Dock et dans la barre des menus. Fermer cette fenêtre ne le quitte pas : vos raccourcis continuent de fonctionner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF StudiosはDockとメニューバーにあります。このウインドウを閉じてもアプリは動き続けるので、ショートカットはそのまま使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios находится в Dock и в строке меню. Если закрыть это окно, приложение продолжит работать, и сочетания клавиш останутся доступны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios живе в Dock і в смузі меню. Якщо закрити це вікно, програма працюватиме далі, тож ваші скорочення не перестануть діяти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 位于程序坞和菜单栏中。关闭此窗口后它仍会继续运行，所以快捷键依然可用。"
          }
        }
      }
    },
    "LF Studios lives in your menu bar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios findest du in der Menüleiste"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios est dans la barre des menus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosはメニューバーにあります"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios находится в строке меню"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios — у вашій смузі меню"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 位于菜单栏中"
          }
        }
      }
    },
    "LF Studios must be running. Turn on Launch LF Studios at login so it always is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios muss laufen. Schalte „LF Studios bei der Anmeldung öffnen“ ein, damit es das immer tut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios doit être ouvert. Activez Ouvrir LF Studios à l’ouverture de session pour qu’il le soit toujours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosが起動している必要があります。常に起動しておくには、“ログイン時にLF Studiosを開く”をオンにします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios должен быть запущен. Включите «Открывать LF Studios при входе в систему», чтобы он работал всегда."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios має бути запущено. Увімкніть «Відкривати LF Studios під час входу», щоб так було завжди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 必须处于运行状态。打开“登录时打开 LF Studios”，让它始终运行。"
          }
        }
      }
    },
    "LF Studios needs Screen Recording permission to capture your screen.\n\nPlease enable it in System Settings → Privacy & Security → Screen & System Audio Recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios braucht die Berechtigung für Bildschirmaufnahmen, um deinen Bildschirm aufzunehmen.\n\nAktiviere sie unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Aufnahme von Bildschirm & Systemaudio“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios a besoin de l’autorisation d’enregistrement de l’écran pour capturer votre écran.\n\nActivez-la dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et des sons du système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosで画面を取り込むには、画面収録のアクセス許可が必要です。\n\n“システム設定”＞“プライバシーとセキュリティ”＞“画面収録とシステムオーディオ録音”でオンにしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы снимать экран, LF Studios нужно разрешение на запись экрана.\n\nВключите его в разделе Системные настройки → Конфиденциальность и безопасность → Запись экрана и системного звука."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios потрібен дозвіл на запис екрана, щоб знімати ваш екран.\n\nУвімкніть його тут: Системні параметри → Приватність і безпека → Записування системного звуку й екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 需要屏幕录制权限才能截取你的屏幕。\n\n请在“系统设置”→“隐私与安全性”→“录屏与系统录音”中启用。"
          }
        }
      }
    },
    "LF Studios never records what you type. See Privacy for exactly what these options save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios zeichnet nie auf, was du tippst. Unter „Datenschutz“ steht genau, was diese Optionen speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios n’enregistre jamais ce que vous tapez. Consultez Confidentialité pour savoir exactement ce que ces options conservent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosが入力内容を記録することはありません。これらのオプションで何が保存されるかは、“プライバシー”で確認できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios никогда не записывает то, что вы печатаете. Что именно сохраняют эти параметры, смотрите в разделе «Конфиденциальность»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ніколи не записує те, що ви друкуєте. Що саме зберігають ці параметри, читайте в розділі «Приватність»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 绝不会记录你输入的内容。这些选项具体会存储什么，请参阅“隐私”。"
          }
        }
      }
    },
    "LF Studios quit unexpectedly last time" : {
      "comment" : "Crash report alert title, on the launch after a crash",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios wurde beim letzten Mal unerwartet beendet"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios s’est fermé de façon inattendue la dernière fois"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回、LF Studiosが予期せず終了しました"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В прошлый раз LF Studios неожиданно завершил работу"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минулого разу LF Studios неочікувано завершив роботу"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 上次意外退出"
          }
        }
      }
    },
    "LF Studios reads the text in every screenshot in the background, on your Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios liest den Text in jedem Bildschirmfoto im Hintergrund, auf deinem Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios lit le texte de chaque capture en arrière-plan, sur votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは、すべてのスクリーンショットのテキストをMac上でバックグラウンドで読み取ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios распознает текст на каждом снимке в фоновом режиме, на вашем Mac."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios у фоновому режимі читає текст на кожному знімку — на вашому Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会在后台读取每张截屏中的文字，全程在你的 Mac 上完成。"
          }
        }
      }
    },
    "LF Studios remembers the area until it quits. With no area yet, you select one as usual." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios merkt sich den Bereich, bis es beendet wird. Gibt es noch keinen Bereich, wählst du wie gewohnt einen aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios garde la zone en mémoire jusqu’à ce que vous le quittiez. S’il n’y a pas encore de zone, vous en sélectionnez une comme d’habitude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは終了するまで範囲を記憶しています。まだ範囲がない場合は、いつもどおりに選択します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios помнит область, пока приложение не завершится. Если области еще нет, вы выделяете ее как обычно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios пам’ятає область, доки ви не завершите програму. Якщо області ще немає, ви вибираєте її як зазвичай."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 在退出前会一直记住该区域。如果还没有区域，就照常选择一个。"
          }
        }
      }
    },
    "LF Studios remembers your last tool, color, and sizes for next time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios merkt sich dein letztes Werkzeug, deine Farbe und Größen fürs nächste Mal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios retient votre dernier outil, votre couleur et vos tailles pour la prochaine fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは、最後に使ったツール、カラー、サイズを次回のために記憶します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios запоминает последний инструмент, цвет и размеры до следующего раза."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios запам’ятовує ваш останній інструмент, колір і розміри до наступного разу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会记住你上次使用的工具、颜色和大小，供下次使用。"
          }
        }
      }
    },
    "LF Studios resizes and centers the window. Click Record." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ändert die Größe des Fensters und zentriert es. Klicke auf „Aufzeichnen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios redimensionne et centre la fenêtre. Cliquez sur Enregistrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosがウインドウのサイズを変更して中央に配置します。“収録”をクリックします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios изменит размер окна и поставит его по центру. Нажмите «Записать»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios змінить розмір вікна й розташує його по центру. Клацніть «Записати»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会调整窗口大小并将其居中。点按“录制”。"
          }
        }
      }
    },
    "LF Studios resizes the window and centers it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios ändert die Größe des Fensters und zentriert es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios redimensionne la fenêtre et la centre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosがウインドウのサイズを変更して、中央に配置します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios изменит размер окна и поставит его по центру."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios змінить розмір вікна й розташує його по центру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会调整窗口大小并将其居中。"
          }
        }
      }
    },
    "LF Studios restarts to switch languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios startet neu, um die Sprache zu wechseln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios redémarre pour changer de langue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を切り替えると、LF Studiosが再起動します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сменить язык, LF Studios перезапустится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб змінити мову, LF Studios перезапускається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换语言时，LF Studios 会重新启动。"
          }
        }
      }
    },
    "LF Studios restarts to switch languages. You can also set it in System Settings → General → Language & Region → Applications." : {
      "comment" : "Settings → General, below the language pop-up",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios startet neu, um die Sprache zu wechseln. Du kannst sie auch unter „Systemeinstellungen“ → „Allgemein“ → „Sprache & Region“ → „Apps“ festlegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios redémarre pour changer de langue. Vous pouvez aussi la choisir dans Réglages Système → Général → Langue et région → Applications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を切り替えるとLF Studiosが再起動します。“システム設定”＞“一般”＞“言語と地域”＞“アプリケーション”でも設定できます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сменить язык, LF Studios перезапустится. Язык также можно выбрать в разделе Системные настройки → Основные → Язык и регион → Приложения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб змінити мову, LF Studios перезапускається. Мову також можна задати тут: Системні параметри → Загальні → Мова і регіон → Програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换语言时，LF Studios 会退出并重新打开。你也可以在“系统设置”→“通用”→“语言与地区”→“应用程序”中设置。"
          }
        }
      }
    },
    "LF Studios shows up in that list only after it has asked once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios erscheint erst in dieser Liste, nachdem es einmal gefragt hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios n’apparaît dans cette liste qu’après avoir fait une première demande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは、一度確認したあとでないとこのリストに表示されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios появится в этом списке только после того, как один раз попросит доступ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios з’являється в цьому списку лише після того, як один раз попросить доступ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 询问过一次之后，才会出现在该列表中。"
          }
        }
      }
    },
    "LF Studios takes screenshots, records your screen, and turns your recordings into polished videos. Mark up a screenshot in seconds, or record yourself with your voice and camera, then cut, zoom, add captions, and export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios macht Bildschirmfotos, zeichnet deinen Bildschirm auf und macht aus deinen Aufnahmen schöne Videos. Beschrifte ein Bildschirmfoto in Sekunden oder nimm dich mit Stimme und Kamera auf – dann schneiden, zoomen, Untertitel hinzufügen und exportieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios prend des captures d’écran, enregistre votre écran et transforme vos enregistrements en vidéos soignées. Annotez une capture en quelques secondes, ou enregistrez-vous avec votre voix et votre caméra, puis coupez, zoomez, ajoutez des sous-titres et exportez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosでは、スクリーンショットを撮ったり、画面を収録したり、収録したビデオを見栄えのよい動画に仕上げたりできます。スクリーンショットに数秒で注釈を付けたり、声やカメラと一緒に自分を収録して、カット、ズーム、字幕の追加をしてから書き出したりできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios делает снимки экрана, записывает экран и превращает записи в аккуратные видео. Разметьте снимок за секунды или запишите себя с голосом и камерой, а затем вырежьте лишнее, добавьте увеличения и субтитры и экспортируйте."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios робить знімки екрана, записує екран і перетворює ваші записи на охайні відео. Розмітьте знімок за лічені секунди або запишіть себе з голосом і камерою, а потім виріжте зайве, додайте наближення й субтитри та експортуйте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 可以截屏、录制屏幕，并把录制内容制作成精美的视频。几秒钟就能标注一张截屏；也可以录下你的声音和摄像头画面，然后剪辑、缩放、添加字幕并导出。"
          }
        }
      }
    },
    "LF Studios will wrap these up before it quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios schließt diese Vorgänge vor dem Beenden ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios terminera ces tâches avant de quitter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studiosは終了する前にこれらの処理を完了します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios закончит их перед завершением."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios завершить їх перед виходом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF Studios 会在退出前完成这些任务。"
          }
        }
      }
    },
